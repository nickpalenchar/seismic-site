# Generated from .claude/settings.json by the `allow-list.ts --codex` of the skill `obeya:settings`; edit that file, not this one.
# A Codex rule is a word prefix: a Claude rule without a `*` (an exact command) allows arguments after it here.
# Rules whose `*` stands inside a word have no form here; Seismic applies them itself to its Codex workers:

prefix_rule(pattern=["bun","install"], decision="allow")
prefix_rule(pattern=["bun","install","--frozen-lockfile"], decision="allow")
prefix_rule(pattern=["bun","run","dev"], decision="allow")
prefix_rule(pattern=["bun","run","build"], decision="allow")
prefix_rule(pattern=["bun","run","preview"], decision="allow")
prefix_rule(pattern=["bunx","astro","dev"], decision="allow")
prefix_rule(pattern=["bunx","astro","build"], decision="allow")
prefix_rule(pattern=["bunx","astro","sync"], decision="allow")
prefix_rule(pattern=["bunx","astro","--version"], decision="allow")
prefix_rule(pattern=["cat",".astro/dev.json"], decision="allow")
