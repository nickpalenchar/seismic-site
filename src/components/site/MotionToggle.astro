---
// The reduced-motion tab, hanging from the navbar's bottom edge at the right (SiteHeader.astro, home page only). A click is the visitor's choice from then on (`seismic-motion`); without one, a change of the device's
// preference is followed. Every change is announced ("seismic:motion", lib/motion.ts). MotionInit.astro sets the
// state before first paint. `inline`: a plain checkbox row instead of the tab (the docs' mobile menu).
interface Props { inline?: boolean; }
const { inline = false } = Astro.props;
---
<label class:list={["motion-tab", { inline }]} title="Stops the animations and shows every demo in its finished state">
  <input type="checkbox" data-motion-toggle />
  <span>Prefer reduced motion</span>
</label>

<script>
  const el = document.documentElement;
  const boxes = () => document.querySelectorAll<HTMLInputElement>("[data-motion-toggle]");
  const device = matchMedia("(prefers-reduced-motion: reduce)");
  const set = (reduce: boolean) => {
    el.dataset.motion = reduce ? "reduce" : "full";
    boxes().forEach((box) => { box.checked = reduce; });
    document.dispatchEvent(new CustomEvent("seismic:motion", { detail: { reduce } }));
  };
  boxes().forEach((box) => {
    box.checked = el.dataset.motion === "reduce";
    box.addEventListener("change", () => {
      try { localStorage.setItem("seismic-motion", box.checked ? "reduce" : "full"); } catch {}
      set(box.checked);
    });
  });
  // The tab (not the docs' inline row) tucks away while scrolling down and returns on any scroll up.
  const tab = document.querySelector<HTMLElement>(".motion-tab:not(.inline)");
  if (tab) {
    let last = scrollY;
    addEventListener("scroll", () => {
      const y = scrollY;
      if (Math.abs(y - last) < 4) return;
      tab.classList.toggle("away", y > last && y > 40);
      last = y;
    }, { passive: true });
  }
  device.addEventListener("change", () => {
    let saved = null;
    try { saved = localStorage.getItem("seismic-motion"); } catch {}
    if (!saved) set(device.matches);
  });
</script>

<style>
  /* Positioned against the header: `.top` on the site (sticky), Starlight's `header.header` in the docs (fixed). */
  .motion-tab { position: absolute; top: 100%; right: 24px; z-index: 1; display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px 6px 10px;
    font: 500 12.5px/1.55 var(--sans); color: var(--muted); cursor: pointer; user-select: none;
    background: var(--glass); backdrop-filter: blur(16px) saturate(1.5); -webkit-backdrop-filter: blur(16px) saturate(1.5);
    border: 1px solid var(--line); border-top: 0; border-radius: 0 0 10px 10px; box-shadow: 0 6px 14px -8px rgba(0,0,0,.25); }
  .motion-tab { transition: transform .25s ease, opacity .25s ease; }
  .motion-tab.away { transform: translateY(-100%); opacity: 0; pointer-events: none; }
  .motion-tab:hover { color: var(--ink); }
  .motion-tab input { margin: 0; width: 14px; height: 14px; accent-color: var(--blue); cursor: pointer; }
  .motion-tab:has(input:focus-visible) { outline: 2px solid var(--blue); outline-offset: 2px; }
  @media (max-width: 640px) { .motion-tab { right: 16px; font-size: 12px; } }
  .motion-tab.inline { position: static; padding: 0; font-size: 14px; background: none; backdrop-filter: none; -webkit-backdrop-filter: none; border: 0; box-shadow: none; }

  /* reduced motion: the device's preference, or this tab */
  :global(:root[data-motion="reduce"] *), :global(:root[data-motion="reduce"] *::before), :global(:root[data-motion="reduce"] *::after) {
    transition: none !important; animation: none !important; scroll-behavior: auto !important;
  }
</style>
