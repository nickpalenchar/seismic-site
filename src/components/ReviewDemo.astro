---
// "Watch the demo instead of manually testing": Interactive, animating task demo card, for the Kinship card created in
// the section above (its real demo: public/video/kinship-attendance, from the card's demo directory).
// 1. Initial view: Centered conversation with initial request ("● Initial request") and first user bubble.
// 2. On scroll: Card grows to full two-column layout: chat shifts right, demo module appears on the left.
// 3. Status updates to "● Demo ready".
// 4. Agent reply pops in with character-by-character streaming text and blinking cursor.
// 5. Follow-up feedback ("You · at 0:35") and "Agent is back at work" note complete the story.
---
<div class="rv" id="review-demo-card" role="region" aria-label="Interactive demo card: Club page should show my attendance, regulars">
  <!-- Subtle Replay Button -->
  <button class="rv-replay-pill" id="rv-replay-btn" type="button" title="Replay demo card animation">
    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
      <path d="M3 3v5h5" />
    </svg>
    Replay demo
  </button>

  <div class="rv-head">
    <div class="rv-kind">Task</div>
    <div class="rv-title">Club page should show my attendance, regulars</div>
    <div class="rv-state" id="rv-state">● Initial request</div>
  </div>

  <div class="rv-cols" id="rv-cols">
    <!-- Left: Demo Module (Appears and unrolls on the left) -->
    <div class="rv-left" id="rv-left">
      <video class="rv-video" id="rv-video" src="/video/kinship-attendance/demo.mp4" poster="/video/kinship-attendance/poster.jpg"
        controls preload="metadata" playsinline>
        <track kind="captions" src="/video/kinship-attendance/captions.vtt" srclang="en" label="English" />
      </video>
      <ul class="rv-chapters" id="rv-chapters">
        <li data-t="0"><span>0:00</span>Went to N events</li>
        <li data-t="15.76"><span>0:15</span>On the event page</li>
        <li data-t="19.83"><span>0:19</span>Attendance bar</li>
        <li data-t="35.42"><span>0:35</span>Regular badge</li>
        <li data-t="45.78"><span>0:45</span>More history</li>
        <li data-t="55.09"><span>0:55</span>Recap</li>
      </ul>
      <div class="rv-actions">
        <span class="btn dark">Approve</span>
        <span class="btn">Later …</span>
        <span class="btn">Stop</span>
      </div>
    </div>

    <!-- Right: Conversation (Starts centered, shifts right, streams agent reply) -->
    <div class="rv-right" id="rv-right">
      <div class="rv-cap">Conversation</div>
      <div class="rv-chat" id="rv-chat">
        <!-- Initial User Request (Visible from start) -->
        <div class="msg you" id="rv-msg-initial">
          <b>You · Task</b>Show "Went to N events" next to the club name, and an Attendance bar on the club page that earns the "Regulars" badge at 10.
        </div>

        <!-- Note 1: Agent started -->
        <div class="note rv-anim-item" id="rv-note-start">
          Agent started on seismic/club-page-should-show-my-attendance-prog-016222
        </div>

        <!-- Agent Response (Pops in & streams text) -->
        <div class="msg agent rv-anim-item" id="rv-msg-agent">
          <b>Agent · Handover</b>
          <span class="rv-stream-text" id="rv-stream-text"></span><span class="rv-cursor" id="rv-cursor"></span>
        </div>

        <!-- User Follow-up Question -->
        <div class="msg you rv-anim-item" id="rv-msg-followup">
          <b>You · at 0:35</b>Call the badge "Regulars", as in the brief.
        </div>

        <!-- Note 2: Agent back at work -->
        <div class="note rv-anim-item" id="rv-note-back">
          Agent is back at work
          <span class="rv-stroke" aria-hidden="true"><i></i></span>
        </div>
      </div>
      <div class="rv-compose">Write about 0:35 or hold space</div>
    </div>
  </div>
</div>

<script>
  import { onMotionChange, reducedMotion } from '../lib/motion';
  const card = document.getElementById('review-demo-card')!;
  const stateEl = document.getElementById('rv-state')!;
  const leftModule = document.getElementById('rv-left')!;
  const noteStart = document.getElementById('rv-note-start')!;
  const msgAgent = document.getElementById('rv-msg-agent')!;
  const streamTextEl = document.getElementById('rv-stream-text')!;
  const cursorEl = document.getElementById('rv-cursor')!;
  const msgFollowup = document.getElementById('rv-msg-followup')!;
  const noteBack = document.getElementById('rv-note-back')!;
  const replayBtn = document.getElementById('rv-replay-btn')!;

  const FULL_STREAM_TEXT = "Events now show \u201cWent to N events\u201d next to the club name. Club pages get an Attendance bar that fills in green, and the badge after ten events. The demo shows both.";

  let hasTriggered = false;
  let isRunning = false;
  let timeouts: number[] = [];

  function clearTimeouts() {
    timeouts.forEach((t) => clearTimeout(t));
    timeouts = [];
  }

  function wait(ms: number): Promise<void> {
    return new Promise((res) => {
      const id = window.setTimeout(res, reducedMotion() ? Math.min(ms, 30) : ms);
      timeouts.push(id);
    });
  }

  function resetToInitial() {
    clearTimeouts();
    card.classList.remove('expanded');
    card.style.setProperty('--rv-accent', 'var(--blue)');
    stateEl.textContent = '● Initial request';
    stateEl.style.color = 'var(--blue)';

    noteStart.classList.remove('show');
    msgAgent.classList.remove('show');
    streamTextEl.textContent = '';
    cursorEl.style.display = 'none';
    msgFollowup.classList.remove('show');
    noteBack.classList.remove('show');
  }

  /** The card as it ends: expanded, demo ready, the whole conversation. With reduced motion it is all there is. */
  function showFinished() {
    clearTimeouts();
    isRunning = false;
    card.classList.add('expanded');
    card.style.setProperty('--rv-accent', 'var(--amber)');
    stateEl.textContent = '● Demo ready';
    stateEl.style.color = 'var(--amber)';
    noteStart.classList.add('show');
    msgAgent.classList.add('show');
    streamTextEl.textContent = FULL_STREAM_TEXT;
    cursorEl.style.display = 'none';
    msgFollowup.classList.add('show');
    noteBack.classList.add('show');
  }

  async function runDemoAnimation() {
    if (isRunning) return;
    isRunning = true;
    resetToInitial();

    if (reducedMotion()) {
      showFinished();
      return;
    }

    // 1. Initial State: Centered conversation with initial request
    await wait(350);

    // 2. Card GROWS to full width, chat moves right, demo module unfolds on left
    card.classList.add('expanded');
    card.style.setProperty('--rv-accent', 'var(--amber)');
    stateEl.textContent = '● Demo ready';
    stateEl.style.color = 'var(--amber)';

    await wait(620); // wait for card expansion and left module slide

    // 3. Note 1 fades in: "Agent started on seismic/…"
    noteStart.classList.add('show');

    await wait(360);

    // 4. Agent reply bubble pops in
    msgAgent.classList.add('show');
    cursorEl.style.display = 'inline-block';

    // 5. Stream text character-by-character with natural typing cadence
    for (let i = 0; i < FULL_STREAM_TEXT.length; i++) {
      if (!isRunning) return;
      streamTextEl.textContent += FULL_STREAM_TEXT[i];

      const ch = FULL_STREAM_TEXT[i];
      let delay = 20;
      if (ch === ',' || ch === ';') delay = 90;
      else if (ch === '.') delay = 140;
      else if (Math.random() < 0.15) delay = 28;

      await wait(delay);
    }

    // Streaming finished: cursor blinks briefly then fades
    await wait(420);
    cursorEl.style.display = 'none';

    // 6. User follow-up question pops in
    await wait(280);
    msgFollowup.classList.add('show');

    // 7. Final note: "Agent is back at work"
    await wait(320);
    noteBack.classList.add('show');

    isRunning = false;
  }

  // Scroll trigger
  const observer = new IntersectionObserver(
    ([entry]) => {
      if (entry.isIntersecting && !hasTriggered) {
        hasTriggered = true;
        runDemoAnimation();
      }
    },
    { threshold: 0.22 }
  );
  observer.observe(card);

  // reduced motion: finished from the start, nothing plays when it scrolls into view; turned on midway, it
  // finishes at once
  if (reducedMotion()) {
    hasTriggered = true;
    showFinished();
  }
  onMotionChange((reduced) => {
    if (!reduced) return;
    hasTriggered = true;
    showFinished();
  });

  replayBtn.addEventListener('click', () => { if (!reducedMotion()) runDemoAnimation(); });

  // a chapter jumps the video to its start
  const video = document.getElementById('rv-video') as HTMLVideoElement;
  document.querySelectorAll<HTMLElement>('#rv-chapters li[data-t]').forEach((li) => {
    li.addEventListener('click', () => {
      video.currentTime = Number(li.dataset.t);
      video.play().catch(() => {});
    });
  });
</script>

<style is:global>
  .rv {
    --rv-accent: var(--blue);
    position: relative;
    border-radius: 14px;
    background: var(--panel);
    border: 1px solid var(--glass-edge);
    box-shadow: inset 0 1px 0 var(--glass-hi), var(--lift);
    padding: 26px 30px 26px;
    max-width: 500px;
    margin: 0 auto;
    transition: max-width 0.65s cubic-bezier(0.2, 0.9, 0.3, 1), box-shadow 0.3s;
  }

  .rv.expanded {
    max-width: 100%;
  }

  .rv::before {
    content: "";
    position: absolute;
    left: 30px;
    top: -1px;
    width: 80px;
    height: 3px;
    border-radius: 0 0 3px 3px;
    background: var(--rv-accent, var(--blue));
    box-shadow: 0 0 12px var(--rv-accent, var(--blue));
    transition: background 0.5s ease, box-shadow 0.5s ease;
  }

  /* Quiet floating replay pill */
  .rv-replay-pill {
    position: absolute;
    right: 20px;
    top: 20px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    font-family: inherit;
    color: var(--muted);
    background: var(--card);
    border: 1px solid var(--glass-edge);
    box-shadow: inset 0 1px 0 var(--glass-hi), var(--shadow);
    cursor: pointer;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: transform 0.15s, color 0.15s, background 0.15s, opacity 0.3s;
    opacity: 0;
    pointer-events: none;
  }

  .rv.expanded .rv-replay-pill {
    opacity: 1;
    pointer-events: auto;
  }

  .rv-replay-pill:hover {
    color: var(--ink);
    transform: translateY(-1px);
    background: var(--glass);
  }

  .rv-kind {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--muted);
  }

  .rv-title {
    font-size: 28px;
    font-weight: 650;
    letter-spacing: -.018em;
    line-height: 1.12;
    margin: 2px 0 6px;
  }

  .rv-state {
    font-size: 13px;
    font-weight: 600;
    color: var(--rv-accent, var(--blue));
    transition: color 0.4s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* FLEX COLUMNS: starts centered (chat only), unfolds left module & pushes chat right */
  .rv-cols {
    display: flex;
    gap: 0;
    margin-top: 20px;
    align-items: flex-start;
    transition: gap 0.55s ease;
  }

  .rv.expanded .rv-cols {
    gap: 28px;
  }

  /* Left: Demo Module */
  .rv-left {
    width: 0;
    flex: 0 0 0%;
    opacity: 0;
    overflow: hidden;
    transform: translateX(-28px);
    pointer-events: none;
    transition:
      opacity 0.45s ease 0.12s,
      transform 0.55s cubic-bezier(0.2, 0.9, 0.3, 1) 0.08s,
      flex 0.65s cubic-bezier(0.2, 0.9, 0.3, 1),
      width 0.65s cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .rv.expanded .rv-left {
    flex: 1.7;
    width: auto;
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  /* Right: Conversation Module */
  .rv-right {
    flex: 1;
    width: 100%;
    transition: flex 0.65s cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .rv-video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    background: #0b0a09;
    object-fit: cover;
  }

  .rv-chapters {
    list-style: none;
    margin: 10px 0 0;
    padding: 6px 0;
    border-radius: 10px;
    background: var(--chip);
    font-size: 14px;
  }

  .rv-chapters li {
    padding: 6px 14px;
    cursor: pointer;
    border-radius: 6px;
    transition: background 0.12s;
  }

  .rv-chapters li:hover {
    background: var(--chip);
  }

  .rv-chapters span {
    display: inline-block;
    width: 3em;
    color: var(--muted);
  }

  .rv-actions {
    display: flex;
    gap: 10px;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  .rv-actions .btn {
    padding: 9px 16px;
    font-size: 15px;
    background: var(--chip);
    border-radius: 10px;
    border: 1px solid var(--line);
    cursor: pointer;
    font-weight: 600;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .rv-actions .btn:hover {
    transform: translateY(-1px);
  }

  .rv-actions .btn.dark {
    background: var(--ink);
    color: var(--bg);
    border-color: transparent;
  }

  .rv-cap {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .rv-chat {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px;
    border-radius: 10px;
    background: var(--chip);
    font-size: 13.5px;
    line-height: 1.4;
  }

  .rv-chat .msg {
    padding: 8px 11px;
    border-radius: 10px;
    background: var(--card);
    border: 1px solid var(--glass-edge);
    max-width: 92%;
  }

  .rv-chat .msg b {
    display: block;
    font-size: 11.5px;
    margin-bottom: 2px;
    color: var(--blue);
  }

  .rv-chat .msg.agent b {
    color: var(--amber);
  }

  .rv-chat .msg.you {
    align-self: flex-end;
  }

  .rv-chat .note {
    font-size: 11.5px;
    font-style: italic;
    text-align: center;
    color: var(--muted);
  }

  .rv-compose {
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--line);
    font-size: 13.5px;
    color: var(--muted);
  }

  /* ANIMATING ITEMS & STREAMING TEXT */
  .rv-anim-item {
    opacity: 0;
    max-height: 0;
    margin: 0;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    overflow: hidden;
    transform: translateY(8px) scale(0.97);
    transition:
      opacity 0.28s ease,
      transform 0.32s cubic-bezier(0.2, 1.25, 0.4, 1),
      max-height 0.35s ease,
      margin 0.28s ease,
      padding 0.28s ease;
  }

  .rv-anim-item.show {
    opacity: 1;
    max-height: 120px;
    overflow: visible;
    transform: translateY(0) scale(1);
  }

  .rv-chat .msg.rv-anim-item.show {
    padding: 8px 11px !important;
  }

  .rv-cursor {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    vertical-align: -0.15em;
    margin-left: 2px;
    background: var(--amber);
    animation: rvCursorBlink 0.75s steps(1) infinite;
  }

  @keyframes rvCursorBlink {
    50% { opacity: 0; }
  }

  .rv-stroke {
    display: inline-block;
    width: 24px;
    height: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--amber) 22%, transparent);
    position: relative;
    overflow: hidden;
    vertical-align: middle;
    margin-left: 6px;
  }

  .rv-stroke i {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 9px;
    background: var(--amber);
    border-radius: 2px;
    animation: rvStrokeRun 1.2s ease-in-out infinite alternate;
  }

  @keyframes rvStrokeRun {
    from { left: 0; }
    to { left: 15px; }
  }

  @media (max-width: 760px) {
    .rv {
      padding: 22px 18px;
      max-width: 100% !important;
    }
    .rv-cols {
      flex-direction: column-reverse;
      gap: 16px;
    }
    .rv.expanded .rv-cols {
      gap: 20px;
    }
    .rv-left {
      width: 100% !important;
      transform: translateY(-16px);
      max-height: 0;
      transition: opacity 0.45s ease, transform 0.45s ease, max-height 0.5s ease;
    }
    .rv.expanded .rv-left {
      max-height: 800px;
      transform: translateY(0);
    }
    .rv-title {
      font-size: 24px;
    }
  }

  :root[data-motion="reduce"] .rv-replay-pill { display: none; }
  /* reduced motion: the device's preference, or the toggle under the navbar (Base.astro) */
  :root[data-motion="reduce"] .rv, :root[data-motion="reduce"] .rv-left, :root[data-motion="reduce"] .rv-right, :root[data-motion="reduce"] .rv-cols, :root[data-motion="reduce"] .rv-anim-item, :root[data-motion="reduce"] .rv-replay-pill {
      transition: none !important;
      animation: none !important;
      transform: none !important;
    }
  :root[data-motion="reduce"] .rv-stroke i, :root[data-motion="reduce"] .rv-cursor {
      animation: none !important;
    }
</style>
