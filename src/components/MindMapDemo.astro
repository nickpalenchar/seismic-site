---
// "Mind map your project": a patch of the real canvas, as the app draws it (frosted bar on top, minimap bottom left,
// mic bottom middle, dotted board, fixed-size cards, dependency arrows). A sonar dot invites a double-click (double-tap on touch).
// The card appears where you click, unfolds into the open card over a dimmed canvas (as in the app: a flight to the
// middle, then the unfold), its description types in, "Start agent" is pressed, and it folds back into its place, working,
// with an animated dependency arrow connecting it to the active workflow. The first card is Kinship's attendance/Regulars
// task: its status line then advances through the agent's steps every 8–13 s and ends recording the demo.
---
<div class="mm" id="mm" role="application" aria-label="Interactive demo: double-click the canvas to create a task card">
  <div class="mm-chrome" aria-hidden="true">
    <div class="mm-bar">
      <img src="/img/logo.svg" alt="" width="26" height="26" />
      <span class="mm-pill"><b>kinship</b> <i>main</i></span>
      <span class="mm-pill hide-s">Archive</span>
      <span class="mm-pill hide-s">Queue <em>1</em></span>
      <span class="mm-pill">+ New task</span>
      <span class="mm-right"><span class="mm-pill hide-s">Configuration</span></span>
    </div>
    <div class="mm-map" id="mm-map"></div>
    <div class="mm-mic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></div>
  </div>

  <!-- SVG Dependency Arrows -->
  <svg class="mm-deps" id="mm-deps" aria-hidden="true">
    <!-- Settled line: Calendar view (a) -> Waitlist (b) -->
    <path id="mm-line-ab" class="mm-path done" />
    <path id="mm-head-ab" class="mm-head done" />
    <path id="mm-pulse-ab" class="mm-pulse done" />
    <!-- Dynamic lines to newly created cards -->
    <g id="mm-dynamic-lines"></g>
  </svg>

  <div class="mm-card static a hide-s" id="mm-card-a" style="--c:var(--green)">
    <div class="cs-handles" aria-hidden="true"><span class="cs-dot dot-t"></span><span class="cs-dot dot-r"></span><span class="cs-dot dot-b"></span><span class="cs-dot dot-l"></span></div>
    <span class="kind">Task</span>
    <b class="ttl">Calendar view for Events</b>
    <p class="meta">A month grid with a chip per event, in its club's colour.</p>
    <span class="state">Approved</span>
  </div>

  <div class="mm-card static b hide-s" id="mm-card-b" style="--c:var(--blue)">
    <div class="cs-handles" aria-hidden="true"><span class="cs-dot dot-t"></span><span class="cs-dot dot-r"></span><span class="cs-dot dot-b"></span><span class="cs-dot dot-l"></span></div>
    <span class="kind">Task</span>
    <b class="ttl">Waitlist for full events</b>
    <p class="meta">Writing the waitlist migration.</p>
    <span class="state working">Agent at work<i class="stroke"></i></span>
  </div>

  <div class="mm-hint" id="mm-hint">
    <span class="sonar"><i></i><i></i><i></i></span>
    <span class="mm-label"><span class="pc">Double-click</span><span class="touch">Double-tap</span> to create a task</span>
  </div>

  <div class="mm-dim" id="mm-dim"></div>
  <div class="mm-panel" id="mm-panel" aria-hidden="true">
    <div class="inner">
      <button class="close" id="mm-close" type="button" aria-label="Close">×</button>
      <div class="p-kind">Task</div>
      <div class="p-title" id="mm-ptitle"><span class="ph">What is it about?</span></div>
      <div class="p-state"><span class="dotm">●</span> New</div>
      <div class="p-body" id="mm-pbody"><span class="ph">Description</span><span class="caret"></span></div>
      <div class="p-foot">
        <button class="btn primary" id="mm-start" type="button">Start agent<span class="sonar mini" aria-hidden="true"><i></i><i></i><i></i></span></button>
        <span class="hint">An agent starts on a branch of its own and shows a demo at the end.</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { reducedMotion } from '../lib/motion';
  import { linkWithHead } from '../lib/arrow';
  const $ = (id: string) => document.getElementById(id)!;
  const area = $('mm'), hint = $('mm-hint'), dim = $('mm-dim'), panel = $('mm-panel'), pbody = $('mm-pbody'),
    ptitle = $('mm-ptitle'), start = $('mm-start'), map = $('mm-map');
  const lineAB = $('mm-line-ab') as unknown as SVGPathElement;
  const headAB = $('mm-head-ab') as unknown as SVGPathElement;
  const pulseAB = $('mm-pulse-ab') as unknown as SVGPathElement;
  const dynamicLines = $('mm-dynamic-lines');
  const cardA = $('mm-card-a');
  const cardB = $('mm-card-b');

  const UNFOLD = 300;
  const HEAD = 10;

  interface Task {
    t: string;
    d: string;
    /** What the card's status line says while its agent works, in order; the last one is while it records the demo. */
    steps?: string[];
    /** A title that takes two lines: the card is a little taller. */
    tall?: boolean;
  }
  const tasks: Task[] = [
    {
      t: 'Club page should show my attendance, regulars',
      d: 'On events at clubs I\'ve been to, show "Went to N events" next to the club name.\n\n'
        + 'On the club page, add a section for my achievements: an "Attendance" bar of 10 grey segments that fill in '
        + 'green as I attend, with the hint "Attend 10 times to become a regular". At 10, I earn the "Regulars" badge.',
      steps: [
        'Reading the code: planning attendance counts + Regulars section',
        'Building attendance counts on events, attendance bar + Regulars badge',
        'Running regression tests',
        'Built and committed, tests pass, recording demo',
      ],
      tall: true,
    },
    { t: 'Add to calendar', d: 'An .ics download and a Google Calendar link on the event page.' },
    { t: 'Search clubs on Discover', d: 'A search box and category chips above the club grid, kept in the URL.' },
    { t: 'Club discussion thread', d: 'Members post on the club page; organizers get an "Organizer" tag.' },
    { t: 'Recurring events', d: 'Store the repeat rule; cancel a single date without touching the rest.' },
  ];
  let n = 0, busy = false, hurry = false, closeReq = false;
  let decide: ((v: 'start' | 'close') => void) | null = null;
  const cards: HTMLElement[] = [];
  const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, hurry || reducedMotion() ? 0 : ms));
  const frame = () => new Promise<void>((r) => requestAnimationFrame(() => r()));

  type B = { x: number; y: number; w: number; h: number };
  const rectOf = (el: HTMLElement) => ({ left: el.offsetLeft, top: el.offsetTop, width: el.offsetWidth, height: el.offsetHeight });
  const boxOf = (el: HTMLElement): B => ({ x: el.offsetLeft, y: el.offsetTop, w: el.offsetWidth, h: el.offsetHeight });

  const setRect = (r: { left: number; top: number; width: number; height: number }) => {
    panel.style.left = r.left + 'px'; panel.style.top = r.top + 'px'; panel.style.width = r.width + 'px'; panel.style.height = r.height + 'px';
  };
  const openRect = () => {
    const W = area.clientWidth, H = area.clientHeight, w = Math.min(600, W - 24), h = Math.min(380, H - 100);
    return { left: (W - w) / 2, top: Math.max(66, (H - h) / 2 + 24), width: w, height: h };
  };

  function path(a: B, b: B) {
    const gapX = Math.max(b.x - (a.x + a.w), a.x - (b.x + b.w)), gapY = Math.max(b.y - (a.y + a.h), a.y - (b.y + b.h));
    const across = gapX > gapY;
    const dir = (across ? Math.sign(b.x + b.w / 2 - (a.x + a.w / 2)) : Math.sign(b.y + b.h / 2 - (a.y + a.h / 2))) || 1;
    const [x1, y1] = across ? [dir > 0 ? a.x + a.w : a.x, a.y + a.h / 2] : [a.x + a.w / 2, dir > 0 ? a.y + a.h : a.y];
    const [x2, y2] = across ? [(dir > 0 ? b.x : b.x + b.w) - dir * HEAD, b.y + b.h / 2] : [b.x + b.w / 2, (dir > 0 ? b.y : b.y + b.h) - dir * HEAD];
    const along = across ? x2 - x1 : y2 - y1, aside = across ? y2 - y1 : x2 - x1;
    const reach = dir * Math.max((dir * along) / 2, Math.min(Math.abs(aside) / 2, HEAD));
    const [c1x, c1y, c2x, c2y] = across ? [x1 + reach, y1, x2 - reach, y2] : [x1, y1 + reach, x2, y2 - reach];
    return linkWithHead(x1, y1, c1x, c1y, c2x, c2y, x2, y2);
  }

  function updateStaticArrow() {
    if (!cardA || !cardB || !lineAB || window.innerWidth < 760) {
      if (lineAB) lineAB.style.display = 'none';
      if (pulseAB) pulseAB.style.display = 'none';
      if (headAB) headAB.style.display = 'none';
      return;
    }
    lineAB.style.display = '';
    if (pulseAB) pulseAB.style.display = '';
    if (headAB) headAB.style.display = '';
    const { d, head } = path(boxOf(cardA), boxOf(cardB));
    lineAB.setAttribute('d', d);
    headAB.setAttribute('d', head);
    if (pulseAB) pulseAB.setAttribute('d', d);
  }

  function drawMap() {
    map.innerHTML = '';
    const W = area.clientWidth, H = area.clientHeight;
    for (const c of area.querySelectorAll<HTMLElement>('.mm-card:not(.gone)')) {
      const s = document.createElement('i');
      s.style.cssText = `left:${(c.offsetLeft / W) * 100}%;top:${(c.offsetTop / H) * 100}%;width:${(c.offsetWidth / W) * 100}%;height:${(c.offsetHeight / H) * 100}%;background:${c.classList.contains('working') ? 'var(--blue)' : c.classList.contains('static') ? (c.style.getPropertyValue('--c') || 'var(--muted)') : 'var(--muted)'}`;
      map.appendChild(s);
    }
    updateStaticArrow();
  }

  interface CreatedEdge {
    from: HTMLElement;
    to: HTMLElement;
    p: SVGPathElement;
    pulse: SVGPathElement;
    h: SVGPathElement;
  }
  const createdEdges: CreatedEdge[] = [];

  function addArrow(fromEl: HTMLElement, toEl: HTMLElement) {
    if (!dynamicLines) return;
    const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    p.setAttribute('class', 'mm-path active');
    const h = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    h.setAttribute('class', 'mm-head active');

    const pulse = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    pulse.setAttribute('class', 'mm-pulse blue');

    const { d, head } = path(boxOf(fromEl), boxOf(toEl));
    h.setAttribute('d', head);
    p.setAttribute('d', d);
    pulse.setAttribute('d', d);

    // Animate drawing stroke
    const len = 400;
    p.style.strokeDasharray = `${len}`;
    p.style.strokeDashoffset = `${len}`;
    p.style.transition = 'stroke-dashoffset 0.6s cubic-bezier(0.2, 0.9, 0.3, 1)';

    dynamicLines.appendChild(p);
    dynamicLines.appendChild(h);
    dynamicLines.appendChild(pulse);
    createdEdges.push({ from: fromEl, to: toEl, p, pulse, h });

    requestAnimationFrame(() => {
      p.style.strokeDashoffset = '0';
    });
  }

  /** How long the agent stays on a step: 15–22s, with reduced motion too (it is the story, not an animation). */
  const stepMs = () => 15000 + Math.random() * 7000;

  function progress(el: HTMLElement, meta: HTMLElement, state: HTMLElement, steps: string[]) {
    meta.textContent = steps[0]!;
    let i = 0;
    const next = () => {
      if (!el.isConnected || ++i >= steps.length) return;
      meta.textContent = steps[i]!;
      meta.classList.remove('tick'); void meta.offsetWidth; meta.classList.add('tick');
      if (i === steps.length - 1) state.innerHTML = 'Agent at work<span class="rec">· Recording demo</span><i class="stroke"></i>';
      else setTimeout(next, stepMs());
    };
    setTimeout(next, stepMs());
  }

  async function create(clientX: number, clientY: number) {
    if (busy) return;
    busy = true; hurry = false; closeReq = false;
    const task = tasks[n++ % tasks.length];
    const r = area.getBoundingClientRect();
    hint.classList.add('done');

    // the card, where it was made
    const el = document.createElement('div');
    el.className = 'mm-card fresh' + (task.tall ? ' tall' : '');
    el.style.setProperty('--c', 'var(--muted)');
    el.innerHTML = '<div class="cs-handles" aria-hidden="true"><span class="cs-dot dot-t"></span><span class="cs-dot dot-r"></span><span class="cs-dot dot-b"></span><span class="cs-dot dot-l"></span></div><span class="kind">Task</span><b class="ttl untitled">New task</b><p class="meta"></p><span class="state">Planned</span>';
    area.appendChild(el);
    const w = el.offsetWidth, h = el.offsetHeight;
    el.style.left = Math.max(12, Math.min(clientX - r.left - w / 2, area.clientWidth - w - 12)) + 'px';
    el.style.top = Math.max(70, Math.min(clientY - r.top - h / 2, area.clientHeight - h - 12)) + 'px';
    cards.push(el);

    if (cards.length > 5) {
      const old = cards.shift()!;
      old.classList.add('gone');
      setTimeout(() => { old.remove(); drawMap(); }, 300);
    }
    drawMap();
    const ttl = el.querySelector<HTMLElement>('.ttl')!, meta = el.querySelector<HTMLElement>('.meta')!, state = el.querySelector<HTMLElement>('.state')!;
    await sleep(380);

    // unfold: from the card's rect to the open card's
    ptitle.innerHTML = '<span class="ph">What is it about?</span>';
    // with reduced motion the description is simply there; otherwise a placeholder, then it types itself in
    pbody.innerHTML = reducedMotion() ? `<span class="txt">${task.d.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</span>` : '<span class="ph">Description</span><span class="caret"></span>';
    start.classList.remove('pressed', 'beckon');
    panel.classList.remove('ready', 'anim');
    setRect(rectOf(el));
    panel.style.setProperty('--c', 'var(--muted)');
    panel.classList.add('on'); panel.setAttribute('aria-hidden', 'false');
    await frame(); await frame();
    dim.classList.add('on');
    el.style.visibility = 'hidden';
    panel.classList.add('anim');
    setRect(openRect());
    await sleep(UNFOLD);
    panel.classList.add('ready');

    // the description types itself in
    await sleep(250);
    if (!reducedMotion()) pbody.innerHTML = '<span class="txt"></span><span class="caret"></span>';
    const txt = pbody.querySelector<HTMLElement>('.txt')!;
    if (hurry || reducedMotion()) txt.textContent = task.d;
    else for (let i = 2; i < task.d.length + 2 && !hurry; i += 2) { txt.textContent = task.d.slice(0, i); pbody.scrollTop = pbody.scrollHeight; await sleep(16); }
    txt.textContent = task.d;
    pbody.scrollTop = pbody.scrollHeight;
    await sleep(550);

    // user decision
    hurry = false;
    let choice: 'start' | 'close' = 'close';
    if (!closeReq) {
      start.classList.add('beckon');
      choice = await new Promise<'start' | 'close'>((res) => { decide = res; });
      start.classList.remove('beckon');
    }
    decide = null;
    if (choice === 'start') { start.classList.add('pressed'); await sleep(220); }
    el.style.visibility = '';
    panel.classList.remove('ready');
    dim.classList.remove('on');
    setRect(rectOf(el));
    await sleep(UNFOLD);
    panel.classList.remove('on', 'anim'); panel.setAttribute('aria-hidden', 'true');
    meta.textContent = task.d;
    el.classList.remove('fresh');

    if (choice === 'start') {
      ttl.textContent = task.t; ttl.classList.remove('untitled');
      el.classList.add('working');
      el.style.setProperty('--c', 'var(--blue)');
      state.className = 'state working'; state.innerHTML = 'Agent at work<i class="stroke"></i>';
      if (task.steps) progress(el, meta, state, task.steps);

      // Connect to the previous card or card B with a flowing arrow!
      // (only to a card that shows: on phones card B is hidden, and an arrow from it would start at the corner)
      const parentCard = cards.length > 1 ? cards[cards.length - 2] : cardB;
      if (parentCard && parentCard.offsetParent !== null) {
        addArrow(parentCard, el);
      }
    }

    drawMap();
    busy = false;
  }

  const inCanvas = (t: EventTarget | null) => !(t as HTMLElement).closest('.mm-chrome, .mm-card, .mm-panel, .mm-dim');
  area.addEventListener('dblclick', (e) => { if (inCanvas(e.target)) create(e.clientX, e.clientY); });

  let last = { t: 0, x: 0, y: 0 };
  area.addEventListener('pointerup', (e) => {
    if (e.pointerType !== 'touch' || !inCanvas(e.target)) return;
    const quick = e.timeStamp - last.t < 400 && Math.hypot(e.clientX - last.x, e.clientY - last.y) < 30;
    last = { t: e.timeStamp, x: e.clientX, y: e.clientY };
    if (quick) { last.t = 0; create(e.clientX, e.clientY); }
  });

  const hurryUp = () => { if (!busy) return; hurry = true; closeReq = true; decide?.('close'); };
  start.addEventListener('click', () => { if (decide) decide('start'); });
  dim.addEventListener('click', hurryUp);
  $('mm-close').addEventListener('click', hurryUp);
  addEventListener('keydown', (e) => { if (e.key === 'Escape') hurryUp(); });
  addEventListener('resize', drawMap);
  drawMap();
</script>

<style is:global>
  .mm { position: relative; height: 540px; border-radius: 16px; overflow: hidden; touch-action: manipulation; user-select: none; cursor: crosshair;
    border: 1px solid var(--glass-edge); box-shadow: inset 0 1px 0 var(--glass-hi), var(--shadow);
    background-color: color-mix(in srgb, var(--bg) 60%, transparent);
    background-image: radial-gradient(var(--dot) 1.2px, transparent 1.4px); background-size: 22px 22px; }

  /* SVG Arrows */
  .mm-deps {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    overflow: visible;
  }

  .mm-path {
    fill: none;
    stroke: var(--line);
    stroke-width: 1.8;
  }

  .mm-path.done {
    stroke: var(--green);
    opacity: 0.65;
  }

  .mm-path.active {
    stroke: var(--blue);
    stroke-width: 2.2;
    filter: drop-shadow(0 0 5px rgba(47, 111, 232, 0.4));
  }

  .mm-head { stroke: none; fill: var(--muted); }
  .mm-head.done { fill: var(--green); }
  .mm-head.active { fill: var(--blue); animation: mmHeadIn .25s .45s both; }
  @keyframes mmHeadIn { from { opacity: 0; } to { opacity: 1; } }

  .mm-pulse {
    display: none;
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 10 140;
    stroke-dashoffset: 0;
    animation: mmFlow 2.5s linear infinite;
    pointer-events: none;
  }

  .mm-pulse.done {
    stroke: #ffffff;
    stroke-width: 2.5;
    filter: drop-shadow(0 0 5px var(--green));
  }

  .mm-pulse.blue {
    stroke: #ffffff;
    stroke-width: 3.2;
    filter: drop-shadow(0 0 6px var(--blue));
    animation-duration: 1.8s;
  }

  @keyframes mmFlow {
    from { stroke-dashoffset: 150; }
    to { stroke-dashoffset: 0; }
  }

  /* chrome */
  .mm-chrome { position: absolute; inset: 0; pointer-events: none; z-index: 3; }
  .mm-bar { position: absolute; left: 0; right: 0; top: 0; height: 54px; display: flex; align-items: center; gap: 8px; padding: 0 12px;
    background: color-mix(in srgb, var(--bg) 45%, transparent); backdrop-filter: blur(20px) saturate(1.6); -webkit-backdrop-filter: blur(20px) saturate(1.6); }
  .mm-bar img { margin-right: 4px; }
  .mm-right { margin-left: auto; display: flex; gap: 8px; }
  .mm-pill { height: 32px; display: inline-flex; align-items: center; gap: 6px; padding: 0 13px; border-radius: 999px; font-size: 13px; white-space: nowrap;
    background: var(--card); border: 1px solid var(--glass-edge); box-shadow: inset 0 1px 0 var(--glass-hi), var(--shadow); }
  .mm-pill i { font-style: normal; color: var(--muted); font-size: 12px; }
  .mm-pill em { font-style: normal; font-size: 11px; font-weight: 600; padding: 0 6px; border-radius: 4px; background: var(--chip); color: var(--muted); }
  .mm-map { position: absolute; left: 12px; bottom: 12px; width: 120px; height: 74px; border-radius: 10px; overflow: hidden;
    background: var(--card); border: 1px solid var(--glass-edge); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
  .mm-map i { position: absolute; border-radius: 1.5px; opacity: .85; }
  .mm-mic { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    background: var(--glass); border: 1px solid var(--glass-edge); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: var(--shadow); }

  /* cards */
  .mm-card { --cw: 280px; --ch: 132px; position: absolute; z-index: 2; width: var(--cw); height: var(--ch); padding: 14px 15px 12px; border-radius: 14px;
    background: linear-gradient(var(--card), var(--card)), var(--bg); border: 1px solid var(--glass-edge); backdrop-filter: blur(16px) saturate(1.5); -webkit-backdrop-filter: blur(16px) saturate(1.5);
    box-shadow: inset 0 1px 0 var(--glass-hi), var(--shadow); cursor: default; transition: opacity .3s, transform .2s, box-shadow .2s; }
  .mm-card.fresh { animation: mm-pop .28s cubic-bezier(.2, 1.3, .4, 1); }
  .mm-card.gone { opacity: 0; transform: scale(.95); }
  .mm-card:hover { transform: translateY(-2px); box-shadow: inset 0 1px 0 var(--glass-hi), var(--lift); }
  .mm-card::before { content: ""; position: absolute; left: 14px; top: -1px; width: 46px; height: 3px; border-radius: 0 0 3px 3px; background: var(--c); box-shadow: 0 0 10px var(--c); }
  .mm-card .kind { display: block; font-size: 11.5px; font-weight: 500; color: var(--muted); }
  .mm-card .ttl { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 1px; font-size: 16px; font-weight: 620; letter-spacing: -.012em; line-height: 1.2; }
  .mm-card.tall { --ch: 156px; }
  .mm-card .meta.tick { animation: mm-tick .4s ease; }
  @keyframes mm-tick { from { opacity: 0; transform: translateY(3px); } }
  .mm-card .ttl.untitled { color: var(--muted); font-weight: 400; font-style: italic; }
  .mm-card .meta { margin: 4px 0 0; font-size: 13px; line-height: 1.38; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .mm-card .state { position: absolute; left: 15px; right: 15px; bottom: 10px; display: flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; color: var(--c); white-space: nowrap; overflow: hidden; }
  .mm-card .state .rec { color: var(--green); }
  .mm-card .stroke { width: 36px; height: 2px; border-radius: 2px; background: color-mix(in srgb, var(--c) 22%, transparent); position: relative; overflow: hidden; }
  .mm-card .stroke::after { content: ""; position: absolute; top: 0; bottom: 0; width: 14px; background: var(--c); border-radius: 2px; animation: mm-run 1.5s ease-in-out infinite alternate; }
