---
// "Ensure quality with adversarial code reviews": the Review tab of the "Club page should show my attendance" card,
// as the app draws it (seismic src/ui/detail.tsx ReviewList / ReviewSubmit, styles from src/ui/reviewClasses.ts).
// The items are what a reviewer would raise on that card's real diff (Kinship, commit "Show attendance progress and a
// Regulars badge on club pages"). Each has a severity badge in its colour; the tab counts what waits for the owner by
// severity, each with its shape. Per item the owner picks "Fix it", "As a follow-up task" or "Ignore" (a second click
// takes it back), then "Submit answers" or "Submit to new agent". Fixed items go Fixing → Under review → Fixed; items
// that no longer wait fold to their head line with a status pill.
interface Item {
  n: number;
  sev: "critical" | "major" | "minor" | "low" | "info";
  security?: boolean;
  title: string;
  text: string;
  where: string;
  task: string;
}

const items: Item[] = [
  {
    n: 1,
    sev: "critical",
    security: true,
    title: "Attendance streak endpoint leaks data",
    text: "`GET /api/members/:id/streak` answers for whatever member id is in the URL and never checks who is asking. Anyone can read any member’s attendance, event by event, by counting through the ids.",
    where: "src/features/members/server.ts:58",
    task: "Check who is asking on the streak endpoint",
  },
  {
    n: 2,
    sev: "major",
    title: "Cancelling an RSVP after the event erases the visit",
    text: "`PUT /api/events/:id/rsvp` refuses events that have ended, but `DELETE` does not. Removing a past “going” lowers the attendance count, so a member can lose a Regulars badge they earned.",
    where: "src/features/events/server.ts:176",
    task: "Keep past RSVPs once an event has ended",
  },
  {
    n: 3,
    sev: "minor",
    title: "Attendance aggregate is rerun for every club summary",
    text: "`loadEventSummaries` now queries all of the member’s past RSVPs every time it runs. `loadClubSummaries` calls it once per club for the next event, so opening Discover repeats the same global aggregate for every club; club detail and Me repeat it further. Compute or pass the count map once per response, or scope the query to the club being loaded.",
    where: "src/features/events/server.ts:99",
    task: "Count attendance once per response",
  },
  {
    n: 4,
    sev: "info",
    title: "Attendance counts “going” answers, not check-ins",
    text: "Kinship has no check-in, so a member who said they would go and stayed home still counts. Worth revisiting if check-ins are added.",
    where: "src/features/events/server.ts:52",
    task: "Count check-ins instead of RSVPs",
  },
];

const reviewer = "Codex · gpt-sol-6.1";
// the schema-change page the demo skill renders (seismic plugin/skills/demo/lib/schema.ts), from a models JSON of
// Kinship's tables before and after: attended counts on memberships, attended_at on RSVPs, and a member_badges table
const schemaPage = "/video/kinship-attendance/schema-change.html";
const schemaCaption = "Attendance counts on memberships, attended_at on RSVPs, and a new member_badges table";
const md = (s: string) => s.replace(/`([^`]+)`/g, "<code>$1</code>");
---
<div class="cr" id="cr" data-reviewer={reviewer}>
  <div class="cr-panel is-reviewing" id="cr-panel">
    <button class="cr-replay-pill" id="cr-replay-btn" type="button" title="Replay the code review">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
        <path d="M3 3v5h5" />
      </svg>
      Replay review
    </button>

    <div class="cr-head">
      <div class="rv-kind">Task</div>
      <div class="rv-title">Club page should show my attendance, regulars</div>
      <div class="rv-state reviewing" id="cr-state">
        <span class="cr-state-dot">●</span> Agent reviewing
      </div>
    </div>
    <div class="cr-tabs" role="tablist" aria-label="What the card brings">
      <span class="cr-tab-off" aria-hidden="true">Demo</span>
      <button type="button" role="tab" class="cr-tab" data-tab="schema" aria-selected="false" aria-controls="cr-schema" title={schemaCaption}>
        <svg class="cr-db" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5V19A9 3 0 0 0 21 19V5" /><path d="M3 12A9 3 0 0 0 21 12" /></svg>
        Schema<span class="cr-long">&nbsp;change</span>
      </button>
      <button type="button" role="tab" class="cr-tab on" data-tab="review" aria-selected="true" aria-controls="cr-review">Review<span id="cr-counts"><span class="rv-running"></span></span></button>
      <span class="cr-tab-off" aria-hidden="true">Diff</span>
    </div>

    <div class="cr-schema" id="cr-schema" role="tabpanel" aria-label="Schema change" hidden>
      <p class="cr-schema-cap">{schemaCaption}</p>
      <iframe id="cr-schema-frame" title="Schema change: attendance and the Regulars badge" data-src={schemaPage}></iframe>
    </div>

    <section class="findings" id="cr-review" role="tabpanel" aria-label="Review">
      <div id="cr-busy">
        <p class="rv-busy">Reviewing with {reviewer} …</p>
        <p class="hint">A separate agent reviews this work’s diff against main. You can approve meanwhile.</p>
      </div>
      <h4 class="p-h" id="cr-heading" aria-live="polite" hidden></h4>

      <div id="cr-list">
        {items.map((i) => (
          <div class={`finding ritem ${i.sev}${i.security ? " security" : ""} cr-hidden`} data-n={i.n} data-sev={i.sev} data-task={i.task}>
            <button type="button" class="f-head" aria-expanded="true">
              <span class="f-no">#{i.n}</span>
              <span class={`f-sev ${i.sev}`}>{i.sev}</span>
              <b>{i.title}</b>
              {i.security && <span class="f-tag">Security</span>}
              <span class="f-head-pill"></span>
              <span class="f-chevron" aria-hidden="true">
                <svg class="down" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                <svg class="right" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
              </span>
            </button>
            <div class="f-body">
              <div class="f-text"><span set:html={md(i.text)} /> <span class="f-text-pill"></span></div>
              <div class="f-where"><code>{i.where}</code></div>
              <div class="f-slot">
                <div class="choices single f-choices" role="group" aria-label={`What to do about item ${i.n}`}>
                  <button type="button" class="choice" data-route="fix" aria-pressed="false" title="The card’s agent fixes it and hands over again, with a new demo where the change shows">Fix it</button>
                  <button type="button" class="choice" data-route="later" aria-pressed="false" title="The agent makes it a task of its own that follows up on this card, bundled items as one; it starts at once.">As a follow-up task</button>
                  <button type="button" class="choice" data-route="ignore" aria-pressed="false" title="Not pursued, and not sent to the agent.">Ignore</button>
                </div>
              </div>
              <ol class="f-log"></ol>
            </div>
          </div>
        ))}
      </div>
      <p class="hint" id="cr-hint" hidden>Choose per item, then submit your answers here or send them with a message to the agent.</p>

      <div class="review-submit" id="cr-submit" hidden>
        <button type="button" class="btn primary" id="cr-send"><span>Submit answers</span><small>Claude Code · Opus 5.5</small></button>
        <div class="cr-newagent">
          <button type="button" class="btn" id="cr-new" aria-haspopup="true" aria-expanded="false">Submit to new agent</button>
          <div class="cr-menu" id="cr-menu" hidden role="group" aria-label="Choose an agent for this start">
            <p>This will create a new session with items to fix as its only context.</p>
            <label>Harness <select id="cr-harness"><option>Claude Code</option><option>Codex</option></select></label>
            <label>Model <select id="cr-model"><option>Fable 5.1</option><option>Opus 5.5</option><option>Sonnet 5.5</option></select></label>
            <label>Effort <select id="cr-effort"><option>Medium</option><option>High</option><option>Max</option></select></label>
            <button type="button" class="btn primary" id="cr-go">Start with this choice</button>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  import { onMotionChange, reducedMotion } from "../lib/motion";
  type Sev = "critical" | "major" | "minor" | "low" | "info";
  type Route = "fix" | "later" | "ignore";
  type Status = "raised" | "fixing" | "underReview" | "fixed" | "closed" | "followUp";
  interface ItemState {
    route: Route | null;
    status: Status;
    log: string[];
    flipped: boolean;
    note: string;
  }

  const SEVERITIES: Sev[] = ["critical", "major", "minor", "low", "info"];
  const STATUS_LABEL: Record<Status, string> = {
    raised: "Raised",
    fixing: "Fixing",
    underReview: "Under review",
    fixed: "Fixed",
    closed: "Closed",
    followUp: "Follow-up",
  };
  const STATUS_HINT: Record<Status, string> = {
    raised: "The reviewer raised it; you decide",
    fixing: "The agent is fixing it",
    underReview: "The agent resubmitted it; the next review verifies it",
    fixed: "The reviewer verified the fix",
    closed: "You ignored it",
    followUp: "It becomes a task of its own",
  };

  // the shapes of the severities (seismic src/ui/components/review-severity-icon.tsx), in their count's colour
  const shape = (s: Sev): string => {
    if (s === "info") {
      return '<svg class="sev-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>';
    }
    const body = s === "low"
      ? '<circle cx="8" cy="8" r="4"/>'
      : s === "minor"
        ? '<rect x="3" y="3" width="10" height="10"/>'
        : s === "major"
          ? '<path d="M8 1 15 8 8 15 1 8Z"/>'
          : '<path d="M8 0 13 5 8 10 3 5Z M8 6 13 11 8 16 3 11Z"/>';
    return `<svg class="sev-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">${body}</svg>`;
  };
  const CHECK = '<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
  const CLEAN = '<svg class="rv-clean" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-label="No items waiting for you"><path d="M20 6 9 17l-5-5"/></svg>';

  const root = document.getElementById("cr")!;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const list = $("cr-list");
  const items = [...root.querySelectorAll<HTMLElement>(".finding")];
  const reviewer = root.dataset.reviewer ?? "";
  const numberOf = (f: HTMLElement) => Number(f.dataset.n);
  const sevOf = (f: HTMLElement) => f.dataset.sev as Sev;
  const originals = new Map(items.map((f) => [f, f.querySelector(".f-slot")!.innerHTML]));
  const state = new Map<number, ItemState>();
  let flowTimers: number[] = [];
  let animTimers: number[] = [];
  let reviewing = true;

  const clock = () => new Date().toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
  const waits = (s: ItemState) => s.status === "raised";
  const isOpen = (s: ItemState) => waits(s) !== s.flipped;

  function reset() {
    items.forEach((f) => {
      state.set(numberOf(f), { route: null, status: "raised", log: [], flipped: false, note: "" });
      f.querySelector(".f-slot")!.innerHTML = originals.get(f)!;
    });
  }

  const pill = (status: Status) =>
    `<span class="f-pill ${status}" title="${STATUS_HINT[status]}">${status === "fixed" ? CHECK : ""}${STATUS_LABEL[status]}</span>`;

  /** Waiting items first by severity, then those being fixed or verified, then fixed, closed and follow-ups. */
  function sortItems() {
    const bySev = (a: HTMLElement, b: HTMLElement) => SEVERITIES.indexOf(sevOf(a)) - SEVERITIES.indexOf(sevOf(b)) || numberOf(a) - numberOf(b);
    const byNo = (a: HTMLElement, b: HTMLElement) => numberOf(a) - numberOf(b);
    const of = (statuses: Status[]) => items.filter((f) => statuses.includes(state.get(numberOf(f))!.status));
    const sorted = [
      ...of(["raised"]).sort(bySev),
      ...of(["fixing", "underReview"]).sort(byNo),
      ...of(["fixed"]).sort(byNo),
      ...of(["closed"]).sort(byNo),
      ...of(["followUp"]).sort(byNo),
    ];
    sorted.forEach((f) => list.appendChild(f));
  }

  function counts(visible: HTMLElement[]) {
    const waiting = visible.filter((f) => waits(state.get(numberOf(f))!));
    const busy = visible.some((f) => ["fixing", "underReview"].includes(state.get(numberOf(f))!.status));
    const bySev = SEVERITIES.map((s) => [s, waiting.filter((f) => sevOf(f) === s).length] as const).filter(([, c]) => c > 0);
    if (!bySev.length) return busy ? "" : CLEAN;
    return bySev.map(([s, c]) => `<span class="rv-count ${s}">${shape(s)}${c}</span>`).join("");
  }

  function heading(total: number, open: number) {
    const n = total === 1 ? "1 item" : `${total} items`;
    if (open === total) return n;
    if (open === 0) return `${n}, none waiting for you`;
    return `${open} of ${total} items wait for you`;
  }

  function renderItem(f: HTMLElement) {
    const s = state.get(numberOf(f))!;
    const open = isOpen(s);
    f.classList.toggle("settled", !waits(s));
    f.classList.toggle("folded", !open);
    f.querySelector(".f-head")!.setAttribute("aria-expanded", String(open));
    f.querySelector(".f-head")!.setAttribute("title", open ? "Hide details" : "Show details");
    f.querySelector(".f-head-pill")!.innerHTML = open ? "" : pill(s.status);
    f.querySelector(".f-text-pill")!.innerHTML = open ? pill(s.status) : "";
    f.querySelector(".f-log")!.innerHTML = s.log.map((l) => `<li>${l}</li>`).join("");
    if (waits(s)) {
      f.querySelectorAll<HTMLElement>(".choice").forEach((b) => {
        const on = s.route === b.dataset.route;
        b.classList.toggle("on", on);
        b.setAttribute("aria-pressed", String(on));
      });
    } else {
      f.querySelector(".f-slot")!.innerHTML = s.note ? `<div class="f-status${s.status === "fixing" ? " pending" : ""}">${s.note}</div>` : "";
    }
  }

  function render() {
    items.forEach(renderItem);
    if (reviewing) return;
    const all = items.map((f) => state.get(numberOf(f))!);
    const waiting = all.filter(waits);
    $("cr-heading").textContent = heading(items.length, waiting.length);
    $("cr-counts").innerHTML = counts(items);
    $("cr-hint").hidden = !waiting.some((s) => !s.route);
    $("cr-submit").hidden = !waiting.some((s) => s.route);
    const stateLine = $("cr-state");
    if (waiting.length) {
      stateLine.className = "rv-state waiting";
      stateLine.innerHTML = '<span class="cr-state-dot">●</span> Demo ready · review items wait for you';
    } else if (all.some((s) => s.status === "fixing" || s.status === "underReview")) {
      stateLine.className = "rv-state working";
      stateLine.innerHTML = '<span class="cr-state-dot">●</span> Agent at work · fixing review items';
    } else {
      stateLine.className = "rv-state approved";
      stateLine.innerHTML = '<span class="cr-state-dot">●</span> Demo ready · review settled';
    }
  }

  const clear = (timers: number[]) => { timers.forEach(clearTimeout); return []; };

  function startReview() {
    animTimers = clear(animTimers);
    flowTimers = clear(flowTimers);
    reset();
    reviewing = true;
    sortItems();
    $("cr-panel").classList.add("is-reviewing");
    $("cr-state").className = "rv-state reviewing";
    $("cr-state").innerHTML = '<span class="cr-state-dot">●</span> Agent reviewing';
    $("cr-counts").innerHTML = '<span class="rv-running"></span>';
    $("cr-busy").hidden = false;
    $("cr-heading").hidden = true;
    $("cr-hint").hidden = true;
    $("cr-submit").hidden = true;
    items.forEach((f) => f.classList.add("cr-hidden"));
    closeMenu();
    render();

    const finish = () => {
      $("cr-busy").hidden = true;
      $("cr-heading").hidden = false;
      $("cr-panel").classList.remove("is-reviewing");
      const at = clock();
      items.forEach((f) => { state.get(numberOf(f))!.log = [`${at} · reviewer · Raised`]; });
    };

    if (reducedMotion()) {
      finish();
      items.forEach((f) => f.classList.remove("cr-hidden"));
      reviewing = false;
      render();
      return;
    }

    animTimers.push(window.setTimeout(() => {
      finish();
      render();
      items.forEach((f, idx) => {
        animTimers.push(window.setTimeout(() => {
          f.classList.remove("cr-hidden");
          f.classList.add("cr-pop");
          f.addEventListener("animationend", () => f.classList.remove("cr-pop"), { once: true });
          const visible = items.slice(0, idx + 1);
          $("cr-heading").textContent = heading(visible.length, visible.length);
          $("cr-counts").innerHTML = counts(visible);
          if (idx === items.length - 1) {
            animTimers.push(window.setTimeout(() => { reviewing = false; render(); }, 300));
          }
        }, idx * 300));
      });
    }, 2400));
  }

  // trigger the review when the section scrolls into view
  const observer = new IntersectionObserver((entries) => {
    if (entries.some((e) => e.isIntersecting)) {
      observer.disconnect();
      startReview();
    }
  }, { threshold: 0.15 });
  observer.observe(root);

  // the tabs: Review, and the schema-change page, loaded the first time it is opened. Opening it keeps the card
  // the height it had: the frame takes what the review took (never under SCHEMA_MIN) and scrolls inside
  const frame = $<HTMLIFrameElement>("cr-schema-frame");
  const SCHEMA_MIN = 280;
  const panel = $("cr-panel");
  const fitFrame = (panelHeight: number) => {
    const reserved = panel.style.minHeight;
    panel.style.minHeight = "";
    const frameHeight = frame.offsetHeight + panelHeight - panel.offsetHeight;
    panel.style.minHeight = reserved;
    frame.style.height = `${Math.max(SCHEMA_MIN, frameHeight)}px`;
  };

  // the card starts as tall as it gets: every item raised and open, with the answers ready to submit. A hidden copy
  // of the card at its width is put in that state and measured, so the section never grows while the review plays
  function fullHeight() {
    const copy = panel.cloneNode(true) as HTMLElement;
    const part = (id: string) => copy.querySelector<HTMLElement>(`#${id}`)!;
    copy.classList.remove("is-reviewing");
    part("cr-schema").hidden = true;
    part("cr-review").hidden = false;
    part("cr-busy").hidden = true;
    part("cr-heading").hidden = false;
    part("cr-heading").textContent = heading(items.length, items.length);
    part("cr-state").innerHTML = '<span class="cr-state-dot">●</span> Demo ready · review items wait for you';
    part("cr-counts").innerHTML = SEVERITIES
      .map((sev) => [sev, items.filter((f) => sevOf(f) === sev).length] as const)
      .filter(([, n]) => n > 0)
      .map(([sev, n]) => `<span class="rv-count ${sev}">${shape(sev)}${n}</span>`)
      .join("");
    copy.querySelectorAll<HTMLElement>(".finding").forEach((f) => {
      f.classList.remove("cr-hidden", "cr-pop", "settled", "folded");
      const original = items.find((i) => i.dataset.n === f.dataset.n)!;
      f.querySelector(".f-slot")!.innerHTML = originals.get(original)!;
      f.querySelector(".choice")!.classList.add("on");
      f.querySelector(".f-head-pill")!.innerHTML = "";
      f.querySelector(".f-text-pill")!.innerHTML = pill("raised");
      f.querySelector(".f-log")!.innerHTML = `<li>${clock()} · reviewer · Raised</li>`;
    });
    part("cr-menu").hidden = true;
    // the hint shows while an item has no answer yet, the submit buttons once any has one: at most, both
    part("cr-hint").hidden = false;
    part("cr-submit").hidden = false;
    copy.querySelectorAll("[id]").forEach((el) => el.removeAttribute("id"));
    copy.removeAttribute("id");
    Object.assign(copy.style, { position: "absolute", left: "0", top: "0", width: `${panel.offsetWidth}px`, minHeight: "0", visibility: "hidden", pointerEvents: "none" });
    copy.setAttribute("aria-hidden", "true");
    root.appendChild(copy);
    const height = copy.offsetHeight;
    copy.remove();
    return height;
  }
  let reservedWidth = 0;
  const reserve = () => {
    if (panel.offsetWidth === reservedWidth) return;
    reservedWidth = panel.offsetWidth;
    panel.style.minHeight = `${fullHeight()}px`;
  };
  new ResizeObserver(reserve).observe(root);
  document.fonts?.ready.then(() => { reservedWidth = 0; reserve(); });
  // the page darkens by prefers-color-scheme, which a frame takes from the system, not from the site's toggle:
  // its styles follow the toggle instead (`all` forces the dark look, `not all` the light one)
  const originalStyles = new WeakMap<HTMLStyleElement, string>();
  const syncTheme = () => {
    const doc = frame.contentDocument;
    if (!doc) return;
    const theme = document.documentElement.dataset.theme;
    doc.querySelectorAll("style").forEach((style) => {
      if (!originalStyles.has(style)) originalStyles.set(style, style.textContent ?? "");
      const css = originalStyles.get(style)!;
      style.textContent = theme ? css.replace(/@media\s*\(prefers-color-scheme:\s*dark\)/g, theme === "dark" ? "@media all" : "@media not all") : css;
    });
  };
  new MutationObserver(syncTheme).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  frame.addEventListener("load", () => {
    syncTheme();
    // a link in the page opens outside the demo
    frame.contentDocument?.querySelectorAll("a[href]").forEach((a) => a.setAttribute("target", "_blank"));
  });
  function showTab(tab: string) {
    const panelHeight = panel.offsetHeight;
    root.querySelectorAll<HTMLElement>(".cr-tab").forEach((b) => {
      const on = b.dataset.tab === tab;
      b.classList.toggle("on", on);
      b.setAttribute("aria-selected", String(on));
    });
    $("cr-review").hidden = tab !== "review";
    $("cr-schema").hidden = tab !== "schema";
    if (tab === "schema") {
      fitFrame(panelHeight);
      if (!frame.getAttribute("src")) frame.src = frame.dataset.src!;
    }
  }
  root.querySelectorAll<HTMLElement>(".cr-tab").forEach((b) => b.addEventListener("click", () => showTab(b.dataset.tab!)));

  $("cr-replay-btn").addEventListener("click", () => { showTab("review"); startReview(); });

  // reduced motion turned on while it reviews: the finished review at once
  onMotionChange((reduced) => { if (reduced && reviewing) startReview(); });

  root.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    // a click on an item's head folds or unfolds it
    const head = target.closest<HTMLElement>(".f-head");
    if (head) {
      const s = state.get(numberOf(head.closest<HTMLElement>(".finding")!))!;
      s.flipped = !s.flipped;
      render();
      return;
    }
    // a second click on a choice takes it back
    const b = target.closest<HTMLElement>(".choice");
    if (!b) return;
    const s = state.get(numberOf(b.closest<HTMLElement>(".finding")!))!;
    if (!waits(s)) return;
    s.route = s.route === b.dataset.route ? null : (b.dataset.route as Route);
    render();
  });

  const later = (cb: () => void, ms: number) => { flowTimers.push(window.setTimeout(() => { cb(); sortItems(); render(); }, reducedMotion() ? Math.min(ms, 200) : ms)); };
  const move = (s: ItemState, to: Status, who: string, what = STATUS_LABEL[to]) => {
    s.status = to;
    s.flipped = false;
    s.log.push(`${clock()} · ${who} · ${what}`);
  };

  function submit(who: string) {
    for (const f of items) {
      const s = state.get(numberOf(f))!;
      if (!waits(s) || !s.route) continue;
      if (s.route === "ignore") {
        move(s, "closed", "owner");
        s.note = "";
      } else if (s.route === "later") {
        move(s, "followUp", "owner");
        s.note = "The agent makes it a task …";
        later(() => {
          s.log.push(`${clock()} · worker · Follow-up task made`);
          s.note = `<a href="#mind-map">Follow-up task “${f.dataset.task}” →</a>`;
        }, 1600);
      } else {
        move(s, "fixing", "owner");
        s.note = `${who} fixes it …`;
        later(() => { move(s, "underReview", "worker", "Resubmitted → Under review"); s.note = ""; }, 2600);
        later(() => { move(s, "fixed", "reviewer", "✓ Fixed"); }, 4400);
      }
    }
    closeMenu();
    sortItems();
    render();
  }

  const closeMenu = () => { $("cr-menu").hidden = true; $("cr-new").setAttribute("aria-expanded", "false"); };
  $("cr-send").addEventListener("click", () => submit("The agent"));
  $("cr-new").addEventListener("click", () => {
    const opening = $("cr-menu").hidden;
    $("cr-menu").hidden = !opening;
    $("cr-new").setAttribute("aria-expanded", String(opening));
  });
  $("cr-go").addEventListener("click", () => submit(`A new agent (${$<HTMLSelectElement>("cr-model").value})`));
  document.addEventListener("click", (e) => { if (!(e.target as HTMLElement).closest(".cr-newagent")) closeMenu(); });
  addEventListener("keydown", (e) => { if (e.key === "Escape") closeMenu(); });

  reset();
  render();
</script>

