---
// "HeroFlowShowcase": Fast, free-forming spatial canvas animation.
// Completely unboxed — no screenshot frame, no mock chrome.
// Cards and dependency arrows free-form directly in open space below the hero buttons:
// 1. Zoomed in: "Let organizers run events" (Kinship) pops up large.
// 2. Rapid zoom out: arrow grows out to the "Plan: organizer tools" card, with label chips auto-assigned.
// 3. Fast zoom out: the plan branches into 3 parallel worktrees (create event form, recurring events, waitlist).
// 4. Downstream wave: a suggested follow-up rounds downward; code review, the demo and the reseed branch right.
// 5. Grand Expansion in multiple directions:
//    - The suggested follow-up branches into waitlist promotion tests.
//    - The code review branches into a follow-up from finding #2.
//    - Review + demo converge into organizer tools landing on main.
//    - Reseed + tests converge into the checks on main.
// 6. At random intervals, soft glowing dots fly through the active arrows between cards.
---
<div class="flow-free-stage" id="flow-showcase" role="region" aria-label="Free-forming animation of Seismic autonomous agent orchestration">
  <div class="flow-stage-controls" aria-hidden="true">
    <button class="flow-replay-pill" id="flow-replay-btn" type="button" title="Replay orchestration flow">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
        <path d="M3 3v5h5" />
      </svg>
      Replay flow
    </button>
  </div>

  <div class="flow-free-viewport" id="flow-viewport">
    <div class="flow-free-world" id="flow-world">
      <!-- SVG Dependency Arrows and Flying Dots -->
      <svg class="flow-svg" id="flow-svg" width="1560" height="680" aria-hidden="true">
        <defs id="flow-defs">
          <marker id="f-arrow-blue" viewBox="0 0 9 8" refX="0.5" refY="4" markerWidth="8.5" markerHeight="7.6" orient="auto" markerUnits="userSpaceOnUse">
            <path d="M0,0.8 L8.5,4 L0,7.2 z" fill="var(--blue)" />
          </marker>
          <marker id="f-arrow-amber" viewBox="0 0 9 8" refX="0.5" refY="4" markerWidth="8.5" markerHeight="7.6" orient="auto" markerUnits="userSpaceOnUse">
            <path d="M0,0.8 L8.5,4 L0,7.2 z" fill="var(--amber)" />
          </marker>
          <marker id="f-arrow-purple" viewBox="0 0 9 8" refX="0.5" refY="4" markerWidth="8.5" markerHeight="7.6" orient="auto" markerUnits="userSpaceOnUse">
            <path d="M0,0.8 L8.5,4 L0,7.2 z" fill="var(--purple)" />
          </marker>
          <marker id="f-arrow-teal" viewBox="0 0 9 8" refX="0.5" refY="4" markerWidth="8.5" markerHeight="7.6" orient="auto" markerUnits="userSpaceOnUse">
            <path d="M0,0.8 L8.5,4 L0,7.2 z" fill="var(--teal)" />
          </marker>
          <marker id="f-arrow-green" viewBox="0 0 9 8" refX="0.5" refY="4" markerWidth="8.5" markerHeight="7.6" orient="auto" markerUnits="userSpaceOnUse">
            <path d="M0,0.8 L8.5,4 L0,7.2 z" fill="var(--green)" />
          </marker>
        </defs>

        <g id="flow-base-lines"></g>
        <g id="flow-dots"></g>
      </svg>

      <!-- FREE FORMING CARDS -->
      <!-- COLUMN 1: Inception -->
      <div class="flow-card c1" id="flow-c1" style="left:40px;top:210px;--c:var(--muted)">
        <div class="card-handles"><span class="h-dot"></span><span class="h-dot"></span></div>
        <div class="f-kind"><span class="k-label">Task</span><span class="repo-tag">kinship</span></div>
        <div class="f-title">Let organizers run events</div>
        <div class="f-meta">Jordan wants to post Sourdough meetups</div>
        <div class="f-state"><span class="dotm">●</span> Planned</div>
      </div>

      <!-- COLUMN 2: Feature Decomposition -->
      <div class="flow-card c2" id="flow-c2" style="left:330px;top:210px;--c:var(--blue)">
        <div class="card-handles"><span class="h-dot"></span><span class="h-dot"></span></div>
        <div class="f-kind">
          <span class="k-label">Task</span>
          <div class="f-chips" id="flow-c2-chips">
            <span class="lchip sugg">⚡ High</span>
            <span class="lchip sugg">✦ Frontend</span>
          </div>
        </div>
        <div class="f-title">Plan: organizer tools</div>
        <div class="f-meta">Splitting into three parallel workstreams</div>
        <div class="f-state working">Agent at work<i class="stroke"></i></div>
      </div>

      <!-- COLUMN 3: Parallel Workers -->
      <!-- Card 3A (Top Branch) -->
      <div class="flow-card c3a" id="flow-c3a" style="left:660px;top:50px;--c:var(--blue)">
        <div class="card-handles"><span class="h-dot"></span><span class="h-dot"></span></div>
        <div class="f-kind"><span class="k-label">Task · kinship/clubs</span><span class="lchip">Worktree 1</span></div>
        <div class="f-title">Create event form</div>
        <div class="f-meta">New event button on the club page</div>
        <div class="f-state working">Agent at work<i class="stroke"></i></div>
      </div>

      <!-- Card 3B (Middle Branch) -->
      <div class="flow-card c3b" id="flow-c3b" style="left:660px;top:210px;--c:var(--blue)">
        <div class="card-handles"><span class="h-dot"></span><span class="h-dot"></span></div>
        <div class="f-kind"><span class="k-label">Task · kinship/events</span><span class="lchip">Worktree 2</span></div>
        <div class="f-title">Recurring event series</div>
        <div class="f-meta">Store the repeat rule, cancel one date</div>
        <div class="f-state working">Agent at work<i class="stroke"></i></div>
      </div>

      <!-- Card 3C (Bottom Branch) -->
      <div class="flow-card c3c" id="flow-c3c" style="left:660px;top:370px;--c:var(--amber)">
        <div class="card-handles"><span class="h-dot"></span><span class="h-dot"></span></div>
        <div class="f-kind"><span class="k-label">Task · kinship/events</span><span class="lchip">Worktree 3</span></div>
        <div class="f-title">Waitlist for full events</div>
        <div class="f-meta">Join waitlist once an event fills up</div>
        <div class="f-state" style="color:var(--amber)">● Needs you · demo ready</div>
      </div>

      <!-- AI Suggested Follow-up Card (Rounded Dotted Connection from 3C) -->
      <div class="flow-card c-sugg" id="flow-c-sugg" style="left:660px;top:525px;--c:var(--purple)">
        <div class="card-handles"><span class="h-dot"></span></div>
        <div class="f-kind">
          <span class="k-label sugg-head">
            <svg class="sparkle-svg" viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
              <path d="M12 2L14.4 8.6L21 11L14.4 13.4L12 20L9.6 13.4L3 11L9.6 8.6L12 2Z" />
            </svg>
            AI suggested follow up
          </span>
          <span class="repo-tag">kinship</span>
        </div>
        <div class="f-title">Waitlist promotion alerts</div>
        <div class="f-meta">Suggested from the waitlist demo</div>
        <div class="f-state" style="color:var(--purple)"><span class="dotm">●</span> Ready to queue</div>
      </div>

      <!-- COLUMN 4: Verification, Demos & Intermediate Tasks -->
      <!-- Card 4A (Downstream from Top Card 3A) -->
      <div class="flow-card c4a" id="flow-c4a" style="left:980px;top:50px;--c:var(--teal)">
        <div class="card-handles"><span class="h-dot"></span><span class="h-dot"></span></div>
        <div class="f-kind"><span class="k-label">Review · Claude Opus</span></div>
        <div class="f-title">Adversarial code review</div>
        <div class="f-meta">Checking the form against repo rules</div>
        <div class="f-state" style="color:var(--teal)">● 3 findings checked</div>
      </div>

      <!-- Card 4B (Downstream from Middle Card 3B) -->
      <div class="flow-card c4b" id="flow-c4b" style="left:980px;top:210px;--c:var(--green)">
        <div class="card-handles"><span class="h-dot"></span><span class="h-dot"></span></div>
        <div class="f-kind"><span class="k-label">Demo · 0:38</span></div>
        <div class="f-title">Demo: recurring events</div>
        <div class="f-meta">Recorded on freshly seeded Kinship</div>
        <div class="f-state" style="color:var(--green)">● Demo ready</div>
      </div>

      <!-- Card 4C (Downstream from Schema Migration 3C) -->
      <div class="flow-card c4c" id="flow-c4c" style="left:980px;top:370px;--c:var(--amber)">
        <div class="card-handles"><span class="h-dot"></span><span class="h-dot"></span></div>
        <div class="f-kind"><span class="k-label">Task · kinship/db</span><span class="lchip">Worktree 3</span></div>
        <div class="f-title">Reseed waitlisted events</div>
        <div class="f-meta">Demo data with full events and a queue</div>
        <div class="f-state working">Agent at work<i class="stroke"></i></div>
      </div>

      <!-- Card 4D (Downstream from AI Suggestion cSugg) -->
      <div class="flow-card c4d" id="flow-c4d" style="left:980px;top:525px;--c:var(--purple)">
        <div class="card-handles"><span class="h-dot"></span><span class="h-dot"></span></div>
        <div class="f-kind"><span class="k-label">Task · kinship/tests</span><span class="lchip sugg">✦ Sandbox</span></div>
        <div class="f-title">Waitlist promotion tests</div>
        <div class="f-meta">Someone cancels: first in line goes</div>
        <div class="f-state" style="color:var(--purple)"><span class="dotm">●</span> Planned test</div>
      </div>

      <!-- COLUMN 5: Multi-Directional Branches (Mainline Releases, Follow-ups, Health Audits) -->
      <!-- Card 5A (Upward Follow-up from Code Review 4A) -->
      <div class="flow-card c5a" id="flow-c5a" style="left:1290px;top:50px;--c:var(--blue)">
        <div class="card-handles"><span class="h-dot"></span></div>
        <div class="f-kind"><span class="k-label">Follow-up · Clubs</span><span class="lchip">Worktree 1</span></div>
        <div class="f-title">Validate end after start</div>
        <div class="f-meta">From review finding #2</div>
        <div class="f-state" style="color:var(--blue)">● Queued for worktree 1</div>
      </div>

      <!-- Card 5B (Converged from Review 4A and Demo 4B) -->
      <div class="flow-card c5b" id="flow-c5b" style="left:1290px;top:210px;--c:var(--green)">
        <div class="card-handles"><span class="h-dot"></span></div>
        <div class="f-kind"><span class="k-label">Lands · main</span><span class="lchip">v0.2.0</span></div>
        <div class="f-title">Organizer tools on main</div>
        <div class="f-meta">Form and recurring events land together</div>
        <div class="f-state working" style="color:var(--green)">Landing<i class="stroke"></i></div>
      </div>

      <!-- Card 5C (Converged from Replica 4C and Rollback 4D) -->
      <div class="flow-card c5c" id="flow-c5c" style="left:1290px;top:450px;--c:var(--teal)">
        <div class="card-handles"><span class="h-dot"></span></div>
        <div class="f-kind"><span class="k-label">Checks · main</span></div>
        <div class="f-title">Typecheck &amp; tests</div>
        <div class="f-meta">bun test passing after the merge</div>
        <div class="f-state" style="color:var(--teal)">● All checks green</div>
      </div>
    </div>
  </div>
</div>

<script>
  import { reducedMotion } from '../lib/motion';
  interface Bounds {
    x: number;
    y: number;
    w: number;
    h: number;
  }

  interface ActiveArrow {
    path: SVGPathElement;
    color: string;
    sourceCard: HTMLElement;
    targetCard: HTMLElement;
  }

  const container = document.getElementById('flow-showcase')!;
  const viewport = document.getElementById('flow-viewport')!;
  const world = document.getElementById('flow-world')!;
  const baseLines = document.getElementById('flow-base-lines')!;
  const dotsLayer = document.getElementById('flow-dots')!;
  const svgDefs = document.getElementById('flow-defs')!;
  const replayBtn = document.getElementById('flow-replay-btn')!;

  const c1 = document.getElementById('flow-c1')!;
  const c2 = document.getElementById('flow-c2')!;
  const c2Chips = document.getElementById('flow-c2-chips')!;
  const c3a = document.getElementById('flow-c3a')!;
  const c3b = document.getElementById('flow-c3b')!;
  const c3c = document.getElementById('flow-c3c')!;
  const cSugg = document.getElementById('flow-c-sugg')!;
  const c4a = document.getElementById('flow-c4a')!;
  const c4b = document.getElementById('flow-c4b')!;
  const c4c = document.getElementById('flow-c4c')!;
  const c4d = document.getElementById('flow-c4d')!;
  const c5a = document.getElementById('flow-c5a')!;
  const c5b = document.getElementById('flow-c5b')!;
  const c5c = document.getElementById('flow-c5c')!;

  const allCards = [c1, c2, c3a, c3b, c3c, cSugg, c4a, c4b, c4c, c4d, c5a, c5b, c5c];

  // On a narrow screen the flow runs top to bottom in three lanes, so it fits the width without zooming far out.
  // The waitlist's suggested follow-up sits in a sixth row, reached by a dotted arrow around the right of its lane.
  const narrow = matchMedia('(max-width: 700px)');
  const isVertical = () => narrow.matches;
  const LANE = [0, 244, 488];
  const ROW = [0, 160, 320, 480, 640, 800];
  const verticalLayout = new Map<HTMLElement, [number, number]>([
    [c1, [LANE[1], ROW[0]]],
    [c2, [LANE[1], ROW[1]]],
    [c3a, [LANE[0], ROW[2]]], [c3b, [LANE[1], ROW[2]]], [c3c, [LANE[2], ROW[2]]],
    [c4a, [LANE[0], ROW[3]]], [c4b, [LANE[1], ROW[3]]], [c4c, [LANE[2], ROW[3]]],
    [c5a, [LANE[0], ROW[4]]], [c5b, [LANE[1], ROW[4]]], [c5c, [LANE[2], ROW[4]]],
    [c4d, [LANE[1], ROW[5]]], [cSugg, [LANE[2], ROW[5]]],
  ]);
  // how far the dotted arrow to the suggestion swings out past the right lane
  const SWING = 44;
  const horizontalLayout = new Map(allCards.map((c) => [c, [c.style.left, c.style.top] as const]));
  let layoutMode: 'vertical' | 'horizontal' | null = null;

  function applyLayout() {
    const mode = isVertical() ? 'vertical' : 'horizontal';
    if (mode === layoutMode) return false;
    layoutMode = mode;
    for (const card of allCards) {
      if (mode === 'vertical') {
        const [x, y] = verticalLayout.get(card)!;
        card.style.left = `${x}px`;
        card.style.top = `${y}px`;
      } else {
        const [left, top] = horizontalLayout.get(card)!;
        card.style.left = left;
        card.style.top = top;
      }
    }
    sizeStage();
    return true;
  }

  let hasTriggered = false;
  let runningAnimation = false;
  let timeouts: number[] = [];
  let activeRafIds: number[] = [];
  let activeArrows: ActiveArrow[] = [];
  let dotLoopTimeout: number | null = null;

  function clearTimeouts() {
    timeouts.forEach((t) => clearTimeout(t));
    timeouts = [];
    if (dotLoopTimeout !== null) {
      clearTimeout(dotLoopTimeout);
      dotLoopTimeout = null;
    }
  }

  function stopAllRafs() {
    activeRafIds.forEach((id) => cancelAnimationFrame(id));
    activeRafIds = [];
  }

  function wait(ms: number): Promise<void> {
    return new Promise((res) => {
      const id = window.setTimeout(res, reducedMotion() ? Math.min(ms, 40) : ms);
      timeouts.push(id);
    });
  }

  const box = (el: HTMLElement): Bounds => ({
    x: el.offsetLeft,
    y: el.offsetTop,
    w: el.offsetWidth,
    h: el.offsetHeight,
  });

  // Obeya link curve
  function linkCurve(a: Bounds, b: Bounds, head = 8): string {
    const gapX = Math.max(b.x - (a.x + a.w), a.x - (b.x + b.w));
    const gapY = Math.max(b.y - (a.y + a.h), a.y - (b.y + b.h));
    const across = gapX > gapY;
    const dir = (across ? Math.sign(b.x + b.w / 2 - (a.x + a.w / 2)) : Math.sign(b.y + b.h / 2 - (a.y + a.h / 2))) || 1;
    const [x1, y1] = across ? [dir > 0 ? a.x + a.w : a.x, a.y + a.h / 2] : [a.x + a.w / 2, dir > 0 ? a.y + a.h : a.y];
    const [x2, y2] = across ? [(dir > 0 ? b.x : b.x + b.w) - dir * head, b.y + b.h / 2] : [b.x + b.w / 2, (dir > 0 ? b.y : b.y + b.h) - dir * head];
    const along = across ? x2 - x1 : y2 - y1;
    const aside = across ? y2 - y1 : x2 - x1;
    const reach = dir * Math.max((dir * along) / 2, Math.min(Math.abs(aside) / 2, head));
    const [c1x, c1y, c2x, c2y] = across ? [x1 + reach, y1, x2 - reach, y2] : [x1, y1 + reach, x2, y2 - reach];
    return `M${x1},${y1} C${c1x},${c1y} ${c2x},${c2y} ${x2},${y2}`;
  }

  function getScaleFactor(baseScale: number): number {
    const w = window.innerWidth;
    if (w < 480) return baseScale * 0.52;
    if (w < 768) return baseScale * 0.68;
    if (w < 1024) return baseScale * 0.84;
    return baseScale;
  }

  function moveWorld(cx: number, cy: number, scale: number, durationMs: number) {
    if (reducedMotion()) durationMs = 0;
    const targetX = viewport.clientWidth / 2 - cx * scale;
    const targetY = viewport.clientHeight / 2 - cy * scale;
    world.style.transition = durationMs > 0 ? `transform ${durationMs}ms cubic-bezier(0.2, 0.9, 0.3, 1)` : 'none';
    world.style.transform = `translate(${targetX}px, ${targetY}px) scale(${scale})`;
  }

  // Fast camera control with responsive scaling
  function setCamera(cx: number, cy: number, scale: number, durationMs = 380) {
    moveWorld(cx, cy, getScaleFactor(scale), durationMs);
  }

  // The vertical layout's camera: frames the given cards, as large as fits the stage, up to maxScale
  const FIT_PAD = 12;
  function bounds(cards: HTMLElement[]): Bounds {
    const bs = cards.map(box);
    const x = Math.min(...bs.map((b) => b.x));
    const y = Math.min(...bs.map((b) => b.y));
    // the dotted arrow to the suggestion swings out to the right of the right lane
    const right = Math.max(...bs.map((b) => b.x + b.w + (b.x === LANE[2] ? SWING : 0)));
    const bottom = Math.max(...bs.map((b) => b.y + b.h));
    return { x, y, w: right - x, h: bottom - y };
  }
  function fitCamera(cards: HTMLElement[], maxScale: number, durationMs = 380) {
    const b = bounds(cards);
    const scale = Math.min(maxScale, (viewport.clientWidth - FIT_PAD * 2) / b.w, (viewport.clientHeight - FIT_PAD * 2) / b.h);
    moveWorld(b.x + b.w / 2, b.y + b.h / 2, scale, durationMs);
  }

  // The vertical stage is as tall as the whole flow at the width that fits it; the horizontal one keeps its CSS height
  function sizeStage() {
    if (!isVertical()) {
      container.style.height = '';
      return;
    }
    const b = bounds(allCards);
    const scale = (viewport.clientWidth - FIT_PAD * 2) / b.w;
    container.style.height = `${Math.ceil(b.h * scale + FIT_PAD * 2)}px`;
  }

  function finalCamera(durationMs = 420) {
    if (isVertical()) fitCamera(allCards, 1, durationMs);
    else setCamera(780, 340, 0.60, durationMs);
  }

  /**
   * Creates an arrow that visibly GROWS / WIPES from start to finish.
   * - Uses stroke-dashoffset wiping for solid lines.
   * - Uses an SVG userSpaceOnUse mask for dotted lines so the dots unroll smoothly.
   * - The arrowhead marker snaps into place flush against the target card border on completion.
   */
  function createGrowingArrow(
    dPath: string,
    markerId: string,
    cls: string,
    dotColor: string,
    sourceCard: HTMLElement,
    targetCard: HTMLElement,
    duration = 260
  ): Promise<SVGPathElement> {
    return new Promise((resolve) => {
      const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      p.setAttribute('d', dPath);
      p.setAttribute('class', cls);
      baseLines.appendChild(p);

      const isDotted = cls.includes('dotted');
      const totalLen = Math.ceil(p.getTotalLength()) || 180;

      if (reducedMotion() || duration <= 0) {
        p.setAttribute('marker-end', `url(#${markerId})`);
        activeArrows.push({ path: p, color: dotColor, sourceCard, targetCard });
        resolve(p);
        return;
      }

      if (isDotted) {
        // DOTTED WIPE: SVG mask revealing the dotted line from start to finish
        const maskId = 'fmask-' + Math.random().toString(36).slice(2, 9);
        const mask = document.createElementNS('http://www.w3.org/2000/svg', 'mask');
        mask.id = maskId;
        mask.setAttribute('maskUnits', 'userSpaceOnUse');
        mask.setAttribute('maskContentUnits', 'userSpaceOnUse');
        mask.setAttribute('x', '0');
        mask.setAttribute('y', '0');
        mask.setAttribute('width', '1600');
        mask.setAttribute('height', '1000');

        const maskPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        maskPath.setAttribute('d', dPath);
        maskPath.setAttribute('stroke', '#ffffff');
        maskPath.setAttribute('stroke-width', '24');
        maskPath.setAttribute('stroke-linecap', 'round');
        maskPath.setAttribute('fill', 'none');
        maskPath.style.strokeDasharray = `${totalLen} ${totalLen}`;
        maskPath.style.strokeDashoffset = `${totalLen}`;

        mask.appendChild(maskPath);
        svgDefs.appendChild(mask);
        p.setAttribute('mask', `url(#${maskId})`);

        const anim = maskPath.animate(
          [
            { strokeDashoffset: `${totalLen}px` },
            { strokeDashoffset: '0px' }
          ],
          {
            duration,
            easing: 'cubic-bezier(0.2, 0.85, 0.3, 1)',
            fill: 'forwards'
          }
        );

        anim.onfinish = () => {
          p.removeAttribute('mask');
          mask.remove();
          p.setAttribute('marker-end', `url(#${markerId})`);
          activeArrows.push({ path: p, color: dotColor, sourceCard, targetCard });
          resolve(p);
        };
      } else {
        // SOLID WIPE: stroke-dashoffset growth
        p.style.strokeDasharray = `${totalLen} ${totalLen}`;
        p.style.strokeDashoffset = `${totalLen}`;

        const anim = p.animate(
          [
            { strokeDashoffset: `${totalLen}px` },
            { strokeDashoffset: '0px' }
          ],
          {
            duration,
            easing: 'cubic-bezier(0.2, 0.85, 0.3, 1)',
            fill: 'forwards'
          }
        );

        anim.onfinish = () => {
          p.style.strokeDashoffset = '0';
          p.setAttribute('marker-end', `url(#${markerId})`);
          activeArrows.push({ path: p, color: dotColor, sourceCard, targetCard });
          resolve(p);
        };
      }
    });
  }

  /**
   * Spawns a soft luminous glowing dot that flies smoothly through an arrow from one card to another.
   */
  function spawnFlyingDot(arrow: ActiveArrow, durationMs = 600) {
    if (reducedMotion()) return;
    const path = arrow.path;
    const totalLen = path.getTotalLength();
    if (totalLen <= 0) return;

    const dotGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    dotGroup.setAttribute('class', 'flow-travel-dot');
    dotGroup.style.setProperty('--dot-color', arrow.color);

    // Outer soft glow aura
    const aura = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    aura.setAttribute('r', '7');
    aura.setAttribute('class', 'dot-aura');

    // Mid vibrant halo
    const halo = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    halo.setAttribute('r', '4');
    halo.setAttribute('class', 'dot-halo');

    // Bright white core
    const core = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    core.setAttribute('r', '2.2');
    core.setAttribute('class', 'dot-core');

    dotGroup.appendChild(aura);
    dotGroup.appendChild(halo);
    dotGroup.appendChild(core);

    dotsLayer.appendChild(dotGroup);

    const startPt = path.getPointAtLength(0);
    dotGroup.setAttribute('transform', `translate(${startPt.x}, ${startPt.y})`);

    let startTime: number | null = null;
    let rafId: number;

    function step(now: number) {
      if (!startTime) startTime = now;
      const elapsed = now - startTime;
      const progress = Math.min(1, elapsed / durationMs);

      // Smooth easeInOutQuad easing
      const t = progress < 0.5 ? 2 * progress * progress : 1 - Math.pow(-2 * progress + 2, 2) / 2;
      const pt = path.getPointAtLength(t * totalLen);

      dotGroup.setAttribute('transform', `translate(${pt.x}, ${pt.y})`);

      // Gentle fade in at start, soft fade out as it enters target card
      if (progress < 0.15) {
        dotGroup.style.opacity = String(progress / 0.15);
      } else if (progress > 0.85) {
        dotGroup.style.opacity = String((1 - progress) / 0.15);
      } else {
        dotGroup.style.opacity = '1';
      }

      // Subtle pulse on the destination card when dot arrives
      if (progress > 0.88 && arrow.targetCard && !arrow.targetCard.classList.contains('glow-hit')) {
        arrow.targetCard.classList.add('glow-hit');
        window.setTimeout(() => {
          arrow.targetCard.classList.remove('glow-hit');
        }, 320);
      }

      if (progress < 1) {
        rafId = requestAnimationFrame(step);
        activeRafIds.push(rafId);
      } else {
        dotGroup.remove();
      }
    }

    rafId = requestAnimationFrame(step);
    activeRafIds.push(rafId);
  }

  /**
   * Starts random interval loop sending glowing dots along established arrows.
   */
  function startDotLoop() {
    stopDotLoop();
    if (reducedMotion()) return;

    function next() {
      // Random interval between 1.5s and 3.4s
      const delay = 1500 + Math.random() * 1900;
      dotLoopTimeout = window.setTimeout(() => {
        if (!runningAnimation && hasTriggered && activeArrows.length > 0) {
          // Select random active arrow
          const arrow = activeArrows[Math.floor(Math.random() * activeArrows.length)];
          const len = arrow.path.getTotalLength();
          const flightMs = Math.max(450, Math.min(760, len * 3.0));
          spawnFlyingDot(arrow, flightMs);

          // 28% chance of a staggered secondary dot on another branch
          if (Math.random() < 0.28 && activeArrows.length > 1) {
            window.setTimeout(() => {
              if (runningAnimation || !hasTriggered) return;
              const others = activeArrows.filter((a) => a !== arrow);
              const secondArrow = others[Math.floor(Math.random() * others.length)];
              const secondLen = secondArrow.path.getTotalLength();
              spawnFlyingDot(secondArrow, Math.max(450, Math.min(760, secondLen * 3.0)));
            }, 160);
          }
        }
        next();
      }, delay);
    }

    // First glowing dot glides gently across Arrow 1->2 400ms after choreography settles
    const firstId = window.setTimeout(() => {
      if (!runningAnimation && hasTriggered && activeArrows.length > 0) {
        spawnFlyingDot(activeArrows[0], 500);
      }
      next();
    }, 400);
    timeouts.push(firstId);
  }

  function stopDotLoop() {
    if (dotLoopTimeout !== null) {
      clearTimeout(dotLoopTimeout);
      dotLoopTimeout = null;
    }
  }

  function resetAll() {
    clearTimeouts();
    stopAllRafs();
    stopDotLoop();

    baseLines.innerHTML = '';
    dotsLayer.innerHTML = '';
    activeArrows = [];

    // Remove any orphan masks
    svgDefs.querySelectorAll('mask').forEach((m) => m.remove());

    allCards.forEach((c) => {
      c.classList.remove('visible', 'pop', 'glow-hit');
      c.style.opacity = '0';
      c.style.transform = 'scale(0.85)';
      c.style.boxShadow = '';
    });

    c2Chips.classList.remove('visible');
    world.style.transition = 'none';
  }

  function popCard(el: HTMLElement) {
    if (!runningAnimation && !hasTriggered) return;
    el.classList.add('visible', 'pop');
    el.style.opacity = '1';
    el.style.transform = 'scale(1)';
  }

  // EXPANSIVE FREE-FORMING ORCHESTRATION CHOREOGRAPHY (~3.1s)
  async function runFastOrchestration() {
    if (runningAnimation) return;
    runningAnimation = true;
    resetAll();

    // -------------------------------------------------------------
    // PHASE 1 (0ms): Zoomed in: Task 1 pops up large
    // -------------------------------------------------------------
    if (isVertical()) fitCamera([c1], 1.3, 0);
    else setCamera(150, 265, 1.35, 0);

    await wait(60);
    popCard(c1);

    await wait(260);

    // -------------------------------------------------------------
    // PHASE 2 (320ms): Rapid zoom out, arrow grows to Card 2, status chips auto-assigned
    // -------------------------------------------------------------
    if (isVertical()) fitCamera([c1, c2], 1.05, 360);
    else setCamera(310, 265, 1.05, 360);

    await wait(70);
    const path12 = linkCurve(box(c1), box(c2));
    await createGrowingArrow(path12, 'f-arrow-blue', 'flow-arrow', 'var(--blue)', c1, c2, 240);
    popCard(c2);

    await wait(110);
    c2Chips.classList.add('visible');

    await wait(260);

    // -------------------------------------------------------------
    // PHASE 3 (1020ms): Zoom out, 3 arrows branch with visible STAGGER
    // Center arrow starts first, then top, then bottom
    // -------------------------------------------------------------
    // vertical: from here on the width sets the scale, so the whole flow is framed and grows down inside it
    if (isVertical()) finalCamera(380);
    else setCamera(580, 270, 0.82, 380);

    await wait(70);
    const b2 = box(c2);
    const b3a = box(c3a);
    const b3b = box(c3b);
    const b3c = box(c3c);

    // the plan fans out into its three workstreams: rightward, or downward in the vertical layout
    const branch = (to: Bounds) => {
      if (isVertical()) {
        const [sx, sy] = [b2.x + b2.w / 2, b2.y + b2.h];
        const [tx, ty] = [to.x + to.w / 2, to.y - 8];
        const jy = sy + (ty - sy) * 0.44;
        return tx === sx ? `M${sx},${sy} L${tx},${ty}` : `M${sx},${sy} C${sx},${jy} ${tx},${jy - 10} ${tx},${ty}`;
      }
      const [sx, sy] = [b2.x + b2.w, b2.y + b2.h / 2];
      const [tx, ty] = [to.x - 8, to.y + to.h / 2];
      const jx = sx + (b3b.x - 8 - sx) * 0.44;
      return ty === sy ? `M${sx},${sy} L${tx},${ty}` : `M${sx},${sy} C${jx},${sy} ${jx - 10},${ty} ${tx},${ty}`;
    };
    const pathTop = branch(b3a);
    const pathMid = branch(b3b);
    const pathBtm = branch(b3c);

    // STAGGERED BRANCH 1: Center worker (3B) starts immediately
    const arrowMid = createGrowingArrow(pathMid, 'f-arrow-blue', 'flow-arrow', 'var(--blue)', c2, c3b, 250).then(() => {
      popCard(c3b);
    });

    // STAGGERED BRANCH 2: Top worker (3A) branches 130ms later
    await wait(130);
    const arrowTop = createGrowingArrow(pathTop, 'f-arrow-blue', 'flow-arrow', 'var(--blue)', c2, c3a, 260).then(() => {
      popCard(c3a);
    });

    // STAGGERED BRANCH 3: Bottom worker (3C) branches 140ms later
    await wait(140);
    const arrowBtm = createGrowingArrow(pathBtm, 'f-arrow-amber', 'flow-arrow amber', 'var(--amber)', c2, c3c, 260).then(() => {
      popCard(c3c);
    });

    await Promise.all([arrowMid, arrowTop, arrowBtm]);
    await wait(220);

    // -------------------------------------------------------------
    // PHASE 4 (1840ms): Zoom out to Column 4 (Reviews, Demos & Intermediate Tasks)
    // Downstream branches stagger naturally
    // -------------------------------------------------------------
    if (!isVertical()) setCamera(820, 290, 0.70, 380);

    await wait(70);

    // Dotted curve rounding downward from Bottom Card (c3c) to cSugg
    const bSugg = box(cSugg);
    let pathDottedSugg: string;
    if (isVertical()) {
      // out of the waitlist card's right side, down past its lane, into the suggestion's right side
      const [sx, sy] = [b3c.x + b3c.w, b3c.y + b3c.h / 2];
      const [ex, ey] = [bSugg.x + bSugg.w + 8, bSugg.y + bSugg.h / 2];
      pathDottedSugg = `M${sx},${sy} C${sx + SWING},${sy} ${ex + SWING - 8},${ey} ${ex},${ey}`;
    } else {
      const ptStartX = b3c.x + 60;
      const ptStartY = b3c.y + b3c.h;
      const ptEndX = bSugg.x + 60;
      const ptEndY = bSugg.y - 8;
      pathDottedSugg = `M${ptStartX},${ptStartY} C${ptStartX},${ptStartY + 35} ${ptEndX},${ptEndY - 35} ${ptEndX},${ptEndY}`;
    }
    
    const arrowSugg = createGrowingArrow(pathDottedSugg, 'f-arrow-purple', 'flow-arrow dotted purple', 'var(--purple)', c3c, cSugg, 240).then(() => {
      popCard(cSugg);
    });

    // Top branches to Code Review (4A) staggered 110ms
    await wait(110);
    const path3aTo4a = linkCurve(box(c3a), box(c4a));
    const arrow4a = createGrowingArrow(path3aTo4a, 'f-arrow-teal', 'flow-arrow teal', 'var(--teal)', c3a, c4a, 240).then(() => {
      popCard(c4a);
    });

    // Middle branches to Video Demo (4B) staggered 110ms
    await wait(110);
    const path3bTo4b = linkCurve(box(c3b), box(c4b));
    const arrow4b = createGrowingArrow(path3bTo4b, 'f-arrow-green', 'flow-arrow green', 'var(--green)', c3b, c4b, 240).then(() => {
      popCard(c4b);
    });

    // Bottom horizontal branch to Read-Replica Catchup (4C) staggered 110ms
    await wait(110);
    const path3cTo4c = linkCurve(box(c3c), box(c4c));
    const arrow4c = createGrowingArrow(path3cTo4c, 'f-arrow-amber', 'flow-arrow amber', 'var(--amber)', c3c, c4c, 240).then(() => {
      popCard(c4c);
    });

    await Promise.all([arrowSugg, arrow4a, arrow4b, arrow4c]);
    await wait(220);

    // -------------------------------------------------------------
    // PHASE 5 (2550ms): GRAND EXPANSION in multiple directions!
    // Camera glides out to frame the sprawling network
    // -------------------------------------------------------------
    finalCamera(420);

    await wait(70);

    // 1. AI Suggestion branches rightward to Rollback Simulation (4D)
    const pathSuggTo4d = linkCurve(box(cSugg), box(c4d));
    const arrowSuggTo4d = createGrowingArrow(pathSuggTo4d, 'f-arrow-purple', 'flow-arrow dotted purple', 'var(--purple)', cSugg, c4d, 240).then(() => {
      popCard(c4d);
    });

    // 2. Code Review (4A) branches rightward to Token Refresh Edge Case follow-up (5A)
    await wait(110);
    const path4aTo5a = linkCurve(box(c4a), box(c5a));
    const arrow4aTo5a = createGrowingArrow(path4aTo5a, 'f-arrow-blue', 'flow-arrow', 'var(--blue)', c4a, c5a, 240).then(() => {
      popCard(c5a);
    });

    // 3. Convergent release: Review (4A) and Demo (4B) both curve into Canary Deploy (5B)
    await wait(120);
    const b5b = box(c5b);
    // two arrows into one card arrive side by side: above and below its middle, or left and right of it
    const shift = (b: Bounds, d: number): Bounds => (isVertical() ? { ...b, x: b.x + d } : { ...b, y: b.y + d });
    const boxDeployTop = shift(b5b, -14);
    const boxDeployBtm = shift(b5b, 14);
    const path4aTo5b = linkCurve(box(c4a), boxDeployTop);
    const path4bTo5b = linkCurve(box(c4b), boxDeployBtm);

    const arrow4aTo5b = createGrowingArrow(path4aTo5b, 'f-arrow-green', 'flow-arrow green', 'var(--green)', c4a, c5b, 250);
    const arrow4bTo5b = createGrowingArrow(path4bTo5b, 'f-arrow-green', 'flow-arrow green', 'var(--green)', c4b, c5b, 250).then(() => {
      popCard(c5b);
    });

    // 4. Convergent telemetry: Replica Catchup (4C) and Rollback Simulation (4D) curve into Health Probe (5C)
    await wait(120);
    const b5c = box(c5c);
    const boxProbeTop = shift(b5c, -14);
    const boxProbeBtm = shift(b5c, 14);
    const path4cTo5c = linkCurve(box(c4c), boxProbeTop);
    const path4dTo5c = linkCurve(box(c4d), boxProbeBtm);

    const arrow4cTo5c = createGrowingArrow(path4cTo5c, 'f-arrow-teal', 'flow-arrow teal', 'var(--teal)', c4c, c5c, 260);
    const arrow4dTo5c = createGrowingArrow(path4dTo5c, 'f-arrow-purple', 'flow-arrow dotted purple', 'var(--purple)', c4d, c5c, 260).then(() => {
      popCard(c5c);
    });

    await Promise.all([arrowSuggTo4d, arrow4aTo5a, arrow4aTo5b, arrow4bTo5b, arrow4cTo5c, arrow4dTo5c]);

    await wait(240);
    runningAnimation = false;

    // Start spontaneous glowing dot transmissions across the entire network!
    startDotLoop();
  }

  // Scroll trigger
  const observer = new IntersectionObserver(
    ([entry]) => {
      if (entry.isIntersecting && !hasTriggered) {
        hasTriggered = true;
        runFastOrchestration();
      }
    },
    { threshold: 0.15 }
  );
  observer.observe(container);

  replayBtn.addEventListener('click', () => runFastOrchestration());

  // Window resize fits camera; crossing between the layouts plays the flow again in the new one
  applyLayout();
  window.addEventListener('resize', () => {
    if (applyLayout()) {
      if (hasTriggered) {
        runningAnimation = false;
        runFastOrchestration();
      }
      return;
    }
    sizeStage();
    if (!runningAnimation && hasTriggered) finalCamera(0);
  });
</script>

