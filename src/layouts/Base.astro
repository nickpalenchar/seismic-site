---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Seismic', description = 'Seismic: a spatial canvas for directing AI coding agents.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const links = [
  { href: '/install/', label: 'Install' },
  { href: '/docs/', label: 'Docs' },
  { href: '/demos/', label: 'Demos' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/bakbak-one-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline>
    // Apply a saved choice before first paint; without one the system's preference applies (CSS).
    try { var t = localStorage.getItem('seismic-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <header class="top">
    <a href="/" class="brand" aria-label="Seismic home">
      <img class="wm-light" src="/img/wordmark.svg" alt="Seismic" width="111" height="28" />
      <img class="wm-dark" src="/img/wordmark-dark.svg" alt="" width="111" height="28" />
    </a>
    <nav>
      {links.map((l) => <a href={l.href} aria-current={path === l.href.replace(/\/$/, '') ? 'page' : undefined}>{l.label}</a>)}
      <a class="ext" href="https://github.com/sadilek/obeya" rel="noopener">GitHub</a>
      <button class="theme" id="theme" type="button" aria-label="Toggle light and dark">◐</button>
    </nav>
  </header>
  <slot />
  <footer><span>Seismic, a fork of <a href="https://obeya.si">Obeya</a>.</span><a href="https://github.com/sadilek/obeya" rel="noopener">GitHub</a></footer>
  <script is:inline>
    document.getElementById('theme').addEventListener('click', function () {
      var el = document.documentElement;
      var dark = el.dataset.theme ? el.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      var next = dark ? 'light' : 'dark';
      el.dataset.theme = next;
      try { localStorage.setItem('seismic-theme', next); } catch (e) {}
    });
  </script>
</body>
</html>
